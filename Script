-- ── craft result from the server ──
local ResultSeq, LastResult = 0, nil
if MachineResultEvent then
    MachineResultEvent.OnClientEvent:Connect(function(r)
        if type(r) == "table" and r.Action ~= "Start" and r.Action ~= "Claim" then
            ResultSeq += 1
            LastResult = r
        end
    end)
end

local CraftGap = 0.35 -- seconds between crafts (the server answers each one; raise it if you get rate limited)

-- one craft. returns "ok" | "none" (no complete set) | "fail", info
local function CraftOnce(machine)
    local groups, need = GetGroups(machine)
    if not groups then return "fail", "pet data not ready" end
    local bestIds
    for _, ids in pairs(groups) do
        if #ids >= need and (not bestIds or #ids > #bestIds) then bestIds = ids end
    end
    if not bestIds then return "none" end
    local use = {}
    for i = 1, need do use[i] = bestIds[i] end

    if HideCraftGui then
        CraftGuiUntil = os.clock() + 20
        HideCraftGuisNow()
    end
    local seq0 = ResultSeq
    local okFire, err = pcall(function()
        MachineEvent:FireServer({ PetIds = use, Machine = machine, Action = "Craft" })
    end)
    if not okFire then return "fail", "FireServer error: " .. tostring(err) end

    local t0 = os.clock()
    while os.clock() - t0 < 6 do
        if ResultSeq > seq0 then break end
        local data = GetData()
        if data and data.Pets.Owned[use[1]] == nil then break end -- pets consumed, result event may lag
        task.wait(0.05)
    end
    if ResultSeq > seq0 then
        local r = LastResult
        if r.Success == true then return "ok", r end
        return "fail", tostring(r.Error or r.Message or r.Reason or Ser(r))
    end
    local data = GetData()
    if data and data.Pets.Owned[use[1]] == nil then return "ok" end
    return "fail", "no answer from the server (too far from the machine?)"
end

-- teleports to the machine, crafts every complete set, returns crafted count, last error
local function CraftAll(machine, alive)
    local crafted, fails, lastErr = 0, 0, nil
    local okNear, why = GoNearMachine(machine)
    if not okNear then return 0, why end
    while alive() do
        local status, info = CraftOnce(machine)
        if status == "ok" then
            crafted += 1
            fails = 0
            SetStatus(string.format("crafting %s: %d done, %d sets left", machine, crafted, CountSets(machine)))
            task.wait(CraftGap)
        elseif status == "none" then
            break
        else
            fails += 1
            lastErr = info
            warn("[Craft] " .. tostring(info))
            if fails >= 4 then break end
            task.wait(math.min(0.5 * 2 ^ (fails - 1), 4))
            GoNearMachine(machine) -- maybe we were pushed away, re-check the position
        end
    end
    return crafted, lastErr
end

