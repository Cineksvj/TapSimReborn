-- ─────────────────────────── pages, sections, rows ───────────────────────────
local Current
local function PaintNav()
    for _, p in ipairs(UI.Pages) do
        local act = p == Current
        p.Label.TextColor3 = act and T.Text or T.Label
        p.Label.Font = act and FONT_BOLD or FONT
        p.Icon.ImageColor3 = act and T.Accent or T.Sub
    end
end
function UI:Open(page)
    if type(page) == "string" then for _, p in ipairs(UI.Pages) do if p.Name == page then page = p end end end
    if type(page) ~= "table" then return end
    ClosePop()
    for _, p in ipairs(UI.Pages) do p.Scroll.Visible = p == page end
    local changed = Current ~= page
    Current = page
    Title.Text = page.Name
    Subtitle.Text = page.Group
    PaintNav()
    task.defer(function()
        local y = page.Button.AbsolutePosition.Y - Nav.AbsolutePosition.Y + Nav.CanvasPosition.Y
        H.Tween(Pill, 0.28, { Position = UDim2.fromOffset(10, y) })
    end)
    if changed then
        page.Content.Position = UDim2.fromOffset(0, 12)
        H.Tween(page.Content, 0.35, { Position = UDim2.fromOffset(0, 0) })
    end
    Config.Data.Page = page.Name Config.Save()
end
function UI:Page(name, group, icon, desc)
    local page = { Name = name, Group = group, Rows = {} }
    NavGroup(group)
    NavOrder += 1
    local btn = H.Button({ Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.White, BackgroundTransparency = 1, LayoutOrder = NavOrder, ZIndex = 3 }, NavList)
    H.Corner(btn, 9)
    page.Icon = H.Icon(icon, 16, T.Sub, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), ZIndex = 4 }, btn)
    page.Label = H.Text({ Text = name, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -50, 1, 0), TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, btn)
    page.Button = btn
    btn.MouseEnter:Connect(function() if Current ~= page then H.Tween(btn, 0.14, { BackgroundTransparency = 0.97 }) end H.Tween(page.Icon, 0.2, { Position = UDim2.new(0, 14, 0.5, 0) }) UI.Tip(btn, desc) end)
    btn.MouseLeave:Connect(function() H.Tween(btn, 0.2, { BackgroundTransparency = 1 }) H.Tween(page.Icon, 0.22, { Position = UDim2.new(0, 12, 0.5, 0) }) UI.HideTip() end)
    btn.MouseButton1Click:Connect(function() UI:Open(page) end)
    local scroll = H.New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.White, ScrollBarImageTransparency = 0.8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 3 }, Body)
    local content = H.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 3 }, scroll)
    H.Pad(content, 12, 18, 18, 18)
    page.Scroll, page.Content = scroll, content
    page.Columns = {}
    for i = 1, 2 do
        page.Columns[i] = H.Frame({ Position = UDim2.new((i - 1) / 2, (i - 1) * 8, 0, 0), Size = UDim2.new(0.5, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 3 }, content)
        H.VList(page.Columns[i], 0)
    end
    page.Count = { 0, 0 }

    function page:Section(title, side)
        local ci = side == "Right" and 2 or side == "Left" and 1 or (page.Count[1] <= page.Count[2] and 1 or 2)
        page.Count[ci] = page.Count[ci] + 1
        local wrap = H.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = page.Count[ci], ZIndex = 3 }, page.Columns[ci])
        H.VList(wrap, 0) H.Pad(wrap, 0, 0, 16, 0)
        H.Text({ Text = string.upper(title), Font = FONT_BOLD, TextSize = 11, TextColor3 = T.Dim, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 0, ZIndex = 3 }, wrap)
        local card = H.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Card, LayoutOrder = 1, ZIndex = 3 }, wrap)
        H.Corner(card, 12) H.Stroke(card, 0.955) H.Glass(card, 0.35) H.VList(card, 0)
        local section = { Card = card, N = 0 }
        local function shell(height, label, icon, desc, tall)
            section.N += 1
            local r = H.Button({ Size = UDim2.new(1, 0, 0, height), LayoutOrder = section.N, ZIndex = 3 }, card)
            if tall then r.AutomaticSize = Enum.AutomaticSize.Y end
            local hov = H.Frame({ Position = UDim2.fromOffset(4, 3), Size = UDim2.new(1, -8, 1, -6), BackgroundColor3 = T.White, BackgroundTransparency = 1, ZIndex = 3 }, r)
            H.Corner(hov, 8)
            if section.N > 1 then H.Frame({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = T.White, BackgroundTransparency = 0.945, ZIndex = 4 }, r) end
            local inner = H.Frame({ Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), BackgroundTransparency = 1, ZIndex = 4 }, r)
            H.HList(inner, 10)
            if icon then H.Icon(icon, 16, T.Sub, { LayoutOrder = 1, ZIndex = 5 }, inner) end
            local lbl = H.Text({ Text = label or "", Size = UDim2.new(0, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, ZIndex = 5 }, inner)
            H.New("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }, lbl)
            local right = H.Frame({ Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = 3, ZIndex = 5 }, inner)
            H.HList(right, 10, Enum.HorizontalAlignment.Right)
            r.MouseEnter:Connect(function() H.Tween(hov, 0.14, { BackgroundTransparency = 0.965 }) lbl.TextColor3 = T.Text UI.Tip(r, desc) end)
            r.MouseLeave:Connect(function() H.Tween(hov, 0.2, { BackgroundTransparency = 1 }) lbl.TextColor3 = T.Label UI.HideTip() end)
            table.insert(page.Rows, { Frame = r, Text = string.lower((label or "") .. " " .. (desc or "")) })
            return r, right, lbl
        end

        function section:Row(key, value, icon)
            local r, right = shell(40, key, icon)
            local v = H.Text({ Text = type(value) == "function" and "" or tostring(value), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 1, ZIndex = 5 }, right)
            local obj = {}
            function obj:Set(t) v.Text = tostring(t) end
            if type(value) == "function" then table.insert(UI.Refreshers, function() local ok, res = pcall(value) if ok then v.Text = tostring(res) end end) end
            return obj
        end
        local function plain(text)
            section.N += 1
            local r = H.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = section.N, ZIndex = 3 }, card)
            if section.N > 1 then H.Frame({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = T.White, BackgroundTransparency = 0.945, ZIndex = 4 }, r) end
            H.Pad(r, 11, 12, 11, 12)
            table.insert(page.Rows, { Frame = r, Text = string.lower(text or "") })
            return r
        end
        function section:Label(text)
            local r = plain(text)
            local l = H.Text({ Text = text, TextSize = 13, TextColor3 = T.Sub, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 5 }, r)
            local obj = {}
            function obj:Set(t) l.Text = tostring(t) end
            return obj
        end
        function section:Paragraph(title, body)
            local r = plain(title .. " " .. body)
            H.Text({ Text = title, Font = FONT_BOLD, TextSize = 13, TextColor3 = T.Text, Size = UDim2.new(1, 0, 0, 16), ZIndex = 5 }, r)
            H.Text({ Text = body, TextSize = 12, TextColor3 = T.Sub, TextWrapped = true, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LineHeight = 1.15, ZIndex = 5 }, r)
        end
        function section:Button(text, cb, icon, desc)
            section.N += 1
            local wrap = H.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = section.N, ZIndex = 3 }, card)
            local b = H.Button({ Position = UDim2.fromOffset(8, 5), Size = UDim2.new(1, -16, 1, -10), BackgroundColor3 = T.Field, BackgroundTransparency = 0, ZIndex = 4 }, wrap)
            H.Corner(b, 8) H.Stroke(b, 0.93)
            local inner = H.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5 }, b)
            H.HList(inner, 8, Enum.HorizontalAlignment.Center)
            if icon then H.Icon(icon, 15, T.Sub, { LayoutOrder = 1, ZIndex = 5 }, inner) end
            H.Text({ Text = text, Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, LayoutOrder = 2, ZIndex = 5 }, inner)
            H.Hover(b, T.Field, T.Hover)
            b.MouseEnter:Connect(function() UI.Tip(b, desc) end)
            b.MouseLeave:Connect(UI.HideTip)
            b.MouseButton1Click:Connect(function() task.spawn(cb) end)
            table.insert(page.Rows, { Frame = wrap, Text = string.lower(text) })
        end
        function section:Toggle(name, default, cb, icon, desc)
            local r, right = shell(40, name, icon, desc)
            local obj = { Name = name, Value = false }
            -- keybind tag (right-click the row to bind a key)
            local tag = H.Button({ Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Field, BackgroundTransparency = 0, TextSize = 11, TextColor3 = T.Sub, Visible = false, LayoutOrder = 1, ZIndex = 5 }, right)
            H.Corner(tag, 5) H.Stroke(tag, 0.9) H.Pad(tag, 0, 6, 0, 6)
            local trk = H.Button({ Size = UDim2.fromOffset(36, 20), BackgroundColor3 = T.Off, BackgroundTransparency = 0, LayoutOrder = 2, ZIndex = 5 }, right)
            H.Corner(trk, 10)
            local knob = H.Frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = T.Sub, ZIndex = 6 }, trk)
            H.Corner(knob, 7)
            local function paint()
                H.Tween(trk, 0.22, { BackgroundColor3 = obj.Value and T.Accent or T.Off })
                H.Tween(knob, 0.26, { Position = UDim2.new(0, obj.Value and 26 or 10, 0.5, 0), BackgroundColor3 = obj.Value and T.White or T.Sub })
                local key = UI.Binds[name]
                tag.Visible = key ~= nil
                tag.Text = key and string.lower(string.gsub(key, "Right", "r"):gsub("Left", "l")) or ""
                tag.TextColor3 = obj.Value and T.Accent or T.Sub
            end
            function obj:Set(v, silent)
                v = v and true or false
                if obj.Value == v then paint() return end
                obj.Value = v
                paint()
                if not silent then task.spawn(cb, v) end
                Config.Data.Toggles[name] = v Config.Save()
            end
            local function flip() obj:Set(not obj.Value) end
            trk.MouseButton1Click:Connect(flip)
            r.MouseButton1Click:Connect(flip)
            local function bind()
                tag.Visible = true tag.Text = "press a key" tag.TextColor3 = T.Accent
                UI.Listening = function(keyName)
                    if keyName == "Escape" or keyName == "Backspace" then UI.Binds[name] = nil else UI.Binds[name] = keyName end
                    Config.Data.Binds[name] = UI.Binds[name] Config.Save()
                    paint()
                end
            end
            r.MouseButton2Click:Connect(bind)
            tag.MouseButton1Click:Connect(bind)
            H.OnAccent(paint)
            if default then obj.Value = true end
            paint()
            UI.Toggles[#UI.Toggles + 1] = obj
            return obj
        end
        function section:Slider(name, min, max, value, cb, suffix, icon)
            local r, right = shell(40, name, icon)
            local holder = H.Frame({ Size = UDim2.fromOffset(176, 28), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 5 }, right)
            local trk = H.Frame({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.fromOffset(116, 4), BackgroundColor3 = T.Off, ZIndex = 5 }, holder)
            H.Corner(trk, 2)
            local fill = H.Frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent, ZIndex = 6 }, trk)
            H.Corner(fill, 2)
            local knob = H.Frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = T.White, ZIndex = 7 }, trk)
            H.Corner(knob, 6)
            local val = H.Text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(44, 24), TextSize = 12, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6 }, holder)
            H.OnAccent(function(a) fill.BackgroundColor3 = a end)
            local cur = value
            local function draw()
                local a = (cur - min) / (max - min)
                fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.fromScale(a, 0.5)
                val.Text = tostring(math.floor(cur + 0.5)) .. (suffix or "")
            end
            local hit = H.Button({ Size = UDim2.new(0, 128, 1, 0), ZIndex = 8 }, holder)
            local dragging = false
            hit.MouseButton1Down:Connect(function() dragging = true end)
            UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 and dragging then dragging = false task.spawn(cb, cur) end end)
            UIS.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local x0, w = trk.AbsolutePosition.X, trk.AbsoluteSize.X
                    cur = math.clamp(min + (i.Position.X - x0) / w * (max - min), min, max)
                    draw()
                end
            end)
            draw()
        end
        function section:Graph(sampler, n)
            section.N += 1
            local wrap = H.Frame({ Size = UDim2.new(1, 0, 0, 104), BackgroundTransparency = 1, LayoutOrder = section.N, ZIndex = 3 }, card)
            local area = H.Frame({ Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 1, -34), BackgroundTransparency = 1, ZIndex = 4 }, wrap)
            for i = 0, 2 do H.Frame({ Position = UDim2.new(0, 0, i / 2, 0), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.White, BackgroundTransparency = 0.95, ZIndex = 4 }, area) end
            n = n or 60
            local bars = {}
            for i = 1, n do
                bars[i] = H.Frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / n, 1, 1, 0), Size = UDim2.new(1 / n, -2, 0, 2), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.35, ZIndex = 5 }, area)
                H.Corner(bars[i], 2)
            end
            H.OnAccent(function(a) for _, b in ipairs(bars) do b.BackgroundColor3 = a end end)
            local lo = H.Text({ Position = UDim2.new(0, 12, 1, -20), Size = UDim2.new(0.5, -12, 0, 16), TextSize = 11, TextColor3 = T.Dim, ZIndex = 4 }, wrap)
            local hi = H.Text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 1, -20), Size = UDim2.new(0.5, -12, 0, 16), TextSize = 11, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4 }, wrap)
            local hist = {}
            table.insert(UI.Refreshers, function()
                local ok, v = pcall(sampler)
                if not ok or type(v) ~= "number" then return end
                hist[#hist + 1] = v
                if #hist > n then table.remove(hist, 1) end
                if not page.Scroll.Visible then return end
                local maxv, minv, sum = 60, math.huge, 0
                for _, x in ipairs(hist) do maxv = math.max(maxv, x) minv = math.min(minv, x) sum += x end
                for i = 1, n do
                    local x = hist[#hist - n + i]
                    local b = bars[i]
                    if x then b.Size = UDim2.new(1 / n, -2, math.clamp(x / maxv, 0.02, 1), 0) b.BackgroundTransparency = 0.25 + 0.5 * (1 - i / n) else b.Size = UDim2.new(1 / n, -2, 0, 2) end
                end
                lo.Text = string.format("low %d  ·  avg %d", minv, math.floor(sum / #hist + 0.5))
                hi.Text = string.format("peak %d fps", maxv)
            end)
        end
        function section:Hero(greeting, sub, chips)
            section.N += 1
            local wrap = H.Frame({ Size = UDim2.new(1, 0, 0, 92), BackgroundTransparency = 1, LayoutOrder = section.N, ZIndex = 3 }, card)
            local av = H.New("ImageLabel", { Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(60, 60), BackgroundColor3 = T.Field, BorderSizePixel = 0, Image = Avatar.Image, ZIndex = 4 }, wrap)
            H.Corner(av, 30)
            local ring = H.New("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.2 }, av)
            H.OnAccent(function(a) ring.Color = a end)
            H.Text({ Text = greeting, Font = FONT_BOLD, TextSize = 17, TextColor3 = T.Text, Position = UDim2.fromOffset(88, 18), Size = UDim2.new(1, -100, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, wrap)
            H.Text({ Text = sub, TextSize = 12, TextColor3 = T.Sub, Position = UDim2.fromOffset(88, 42), Size = UDim2.new(1, -100, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, wrap)
            local row = H.Frame({ Position = UDim2.fromOffset(88, 62), Size = UDim2.new(1, -100, 0, 20), BackgroundTransparency = 1, ZIndex = 4 }, wrap)
            H.HList(row, 6)
            local labels = {}
            for i, c in ipairs(chips) do
                local chip = H.Frame({ Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Field, LayoutOrder = i, ZIndex = 4 }, row)
                H.Corner(chip, 10) H.Pad(chip, 0, 8, 0, 8)
                labels[i] = H.Text({ Text = type(c) == "function" and c() or c, Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, TextSize = 11, ZIndex = 5 }, chip)
                if type(c) == "function" then table.insert(UI.Refreshers, function() labels[i].Text = c() end) end
            end
        end
        return section
    end
    table.insert(UI.Pages, page)
    return page
end

