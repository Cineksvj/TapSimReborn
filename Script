local CurrentPage = nil
function UI:Page(name, group, icon, chevron)
    local page = { Name = name, Group = group, Sections = {}, Rows = {} }
    local scroll = New("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false }, Body)
    Pad(scroll, 18, 14, 18, 18)
    local cols = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, scroll)
    HList(cols, 16, Enum.VerticalAlignment.Top)
    page.Columns = {
        New("Frame", { Size = UDim2.new(0.5, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, cols),
        New("Frame", { Size = UDim2.new(0.5, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2 }, cols),
    }
    VList(page.Columns[1], 18) VList(page.Columns[2], 18)
    page.Frame = scroll
    local g = NavGroup(group or "MAIN")
    local btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Card2, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = #g:GetChildren() }, g)
    Corner(btn, 9)
    local mark = New("Frame", { Size = UDim2.fromOffset(3, 18), Position = UDim2.new(0, -16, 0.5, -9), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Visible = false }, btn)
    Corner(mark, 2)
    local ico = Label(btn, icon or "•", 16, Theme.Muted, Theme.Icon, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0, 22, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
    local txt = Label(btn, name, 14, Theme.Muted, Theme.Medium, { Position = UDim2.new(0, 38, 0, 0), Size = UDim2.new(1, -50, 1, 0) })
    if chevron then Label(btn, "›", 18, Theme.Muted, Theme.Icon, { Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0, 12, 1, 0) }) end
    page.Button, page.Mark, page.Text, page.Icon = btn, mark, txt, ico
    btn.MouseButton1Click:Connect(function() UI:Open(page) end)
    btn.MouseEnter:Connect(function() if CurrentPage ~= page then Tween(btn, { BackgroundTransparency = 0.6 }) end end)
    btn.MouseLeave:Connect(function() if CurrentPage ~= page then Tween(btn, { BackgroundTransparency = 1 }) end end)

    local sectionCount = 0
    function page:Section(title, column)
        sectionCount += 1
        local col = page.Columns[column or ((sectionCount % 2 == 1) and 1 or 2)]
        local wrap = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = sectionCount }, col)
        VList(wrap, 8)
        Label(wrap, string.upper(title), 10, Theme.Muted, Theme.Medium, { Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 0 })
        local card = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card, BorderSizePixel = 0, LayoutOrder = 1 }, wrap)
        Corner(card, 12) Border(card) Pad(card, 14, 4, 14, 4)
        VList(card, 0)
        local section = { Card = card, Wrap = wrap, Count = 0 }

        local function rowFrame(h)
            section.Count += 1
            local f = New("Frame", { Size = UDim2.new(1, 0, 0, h or 40), BackgroundTransparency = 1, LayoutOrder = section.Count }, card)
            if section.Count > 1 then New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0 }, f) end
            return f
        end
        local function register(frame, text) table.insert(page.Rows, { Frame = frame, Text = string.lower(text) }) end

        function section:Row(key, value)
            local f = rowFrame(40)
            Label(f, key, 13, Theme.Text, Theme.Font, { Size = UDim2.new(0.5, 0, 1, 0) })
            local v = Label(f, type(value) == "function" and "" or tostring(value), 13, Theme.Muted, Theme.Font, { Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right })
            local obj = {}
            function obj:Set(t) v.Text = tostring(t) end
            if type(value) == "function" then table.insert(UI.Refreshers, function() local ok, r = pcall(value) if ok then v.Text = tostring(r) end end) end
            register(f, key)
            return obj
        end

        function section:Label(text)
            local f = rowFrame(0)
            f.AutomaticSize = Enum.AutomaticSize.Y
            local l = Label(f, text, 13, Theme.Muted, Theme.Font, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true })
            Pad(f, 0, 10, 0, 10)
            local obj = {}
            function obj:Set(t) l.Text = tostring(t) end
            register(f, text)
            return obj
        end

        -- welcome card: avatar with a ring, greeting, subtitle, chips
        function section:Profile(title, subtitle, chips)
            local f = rowFrame(96)
            local av = New("ImageLabel", { Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0, 2, 0.5, -30), BackgroundColor3 = Theme.Card2, BorderSizePixel = 0 }, f)
            Corner(av, 30) Border(av, Theme.Accent, 2)
            pcall(function() av.Image = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
            Label(f, title, 15, Theme.Text, Theme.Bold, { Position = UDim2.new(0, 76, 0, 16), Size = UDim2.new(1, -76, 0, 20) })
            Label(f, subtitle, 11, Theme.Muted, Theme.Font, { Position = UDim2.new(0, 76, 0, 38), Size = UDim2.new(1, -76, 0, 14) })
            local row = New("Frame", { Position = UDim2.new(0, 76, 0, 58), Size = UDim2.new(1, -76, 0, 22), BackgroundTransparency = 1 }, f)
            HList(row, 6)
            for i, c in ipairs(chips or {}) do
                local chip = New("TextLabel", { Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Card2, BorderSizePixel = 0, Text = c, TextSize = 11, TextColor3 = Theme.Text, Font = Theme.Font, LayoutOrder = i }, row)
                Corner(chip, 11) Pad(chip, 9, 0, 9, 0)
            end
            register(f, title)
        end

        function section:Button(text, cb, icon)
            local f = rowFrame(48)
            local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 6), BackgroundColor3 = Theme.Card2, BorderSizePixel = 0, Text = (icon and (icon .. "  ") or "") .. text, TextSize = 13, TextColor3 = Theme.Text, Font = Theme.Medium, AutoButtonColor = false }, f)
            Corner(b, 9) Border(b) Hover(b, Theme.Card2, Theme.Stroke)
            b.MouseButton1Click:Connect(function() task.spawn(cb) end)
            register(f, text)
        end

        function section:Toggle(text, default, cb)
            local f = rowFrame(42)
            Label(f, text, 13, Theme.Text, Theme.Font, { Size = UDim2.new(1, -60, 1, 0) })
            local sw = New("TextButton", { Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -42, 0.5, -11), BackgroundColor3 = Theme.Card2, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, f)
            Corner(sw, 11) Border(sw)
            local knob = New("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = Theme.Muted, BorderSizePixel = 0 }, sw)
            Corner(knob, 8)
            local obj = { Value = false, Name = text }
            local function paint()
                Tween(sw, { BackgroundColor3 = obj.Value and Theme.Accent or Theme.Card2 })
                Tween(knob, { Position = obj.Value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = obj.Value and Color3.new(1, 1, 1) or Theme.Muted })
            end
            function obj:Set(v, silent)
                v = v and true or false
                obj.Value = v
                paint()
                if not silent then task.spawn(cb, v) end
                if UI.OnToggle then UI.OnToggle(obj) end
            end
            sw.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
            if default then obj.Value = true paint() end
            register(f, text)
            return obj
        end

        -- bar graph of a sampled value; the caption shows low / avg / peak of the visible window
        function section:Graph(sampler, bars, unit)
            local f = rowFrame(118)
            local area = New("Frame", { Size = UDim2.new(1, 0, 0, 74), Position = UDim2.new(0, 0, 0, 12), BackgroundTransparency = 1 }, f)
            local n = bars or 60
            local items = {}
            for i = 1, n do
                items[i] = New("Frame", { Size = UDim2.new(1 / n, -2, 0, 2), Position = UDim2.new((i - 1) / n, 0, 1, -2), BackgroundColor3 = Theme.Bar, BorderSizePixel = 0 }, area)
            end
            local capL = Label(f, "", 10, Theme.Muted, Theme.Font, { Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(0.6, 0, 0, 14) })
            local capR = Label(f, "", 10, Theme.Muted, Theme.Font, { Position = UDim2.new(0.6, 0, 1, -20), Size = UDim2.new(0.4, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Right })
            local values, maxv = {}, 1
            table.insert(UI.Refreshers, function()
                local ok, v = pcall(sampler)
                if not ok or type(v) ~= "number" then return end
                table.insert(values, v)
                if #values > n then table.remove(values, 1) end
                local lo, hi, sum = math.huge, 0, 0
                for _, x in ipairs(values) do lo = math.min(lo, x) hi = math.max(hi, x) sum += x end
                maxv = math.max(hi, 1)
                for i = 1, n do
                    local val = values[#values - n + i]
                    local h = val and math.max(2, math.floor(val / maxv * 74)) or 2
                    items[i].Size = UDim2.new(1 / n, -2, 0, h)
                    items[i].Position = UDim2.new((i - 1) / n, 0, 1, -h)
                    items[i].Visible = val ~= nil
                end
                capL.Text = string.format("low %d  ·  avg %d", lo == math.huge and 0 or lo, #values > 0 and sum / #values or 0)
                capR.Text = string.format("peak %d %s", hi, unit or "")
            end)
            register(f, "graph")
        end

        table.insert(page.Sections, section)
        return section
    end

    table.insert(UI.Pages, page)
    if not CurrentPage then UI:Open(page) end
    return page
end

function UI:Open(page)
    for _, p in ipairs(UI.Pages) do
        local active = p == page
        p.Frame.Visible = active
        p.Mark.Visible = active
        p.Text.TextColor3 = active and Theme.Text or Theme.Muted
        p.Icon.TextColor3 = active and Theme.Accent or Theme.Muted
        p.Button.BackgroundTransparency = active and 0 or 1
    end
    CurrentPage = page
    PageTitle.Text = page.Name
    PageSub.Text = page.Group and (string.sub(page.Group, 1, 1) .. string.lower(string.sub(page.Group, 2))) or "Main"
    SearchBox.Text = ""
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    if not CurrentPage then return end
    local q = string.lower(SearchBox.Text)
    for _, r in ipairs(CurrentPage.Rows) do
        r.Frame.Visible = q == "" or string.find(r.Text, q, 1, true) ~= nil
    end
end)
UIS.InputBegan:Connect(function(input, gp)
    if input.KeyCode == Enum.KeyCode.F and UIS:IsKeyDown(Enum.KeyCode.LeftControl) and UI.Visible then SearchBox:CaptureFocus() end
end)

