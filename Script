local function HideGui(g)
    if g.Enabled then
        g.Enabled = false
        HiddenGuis[g] = true
    end
end

local function HideCraftGuisNow()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, g in ipairs(pg:GetChildren()) do
        if IsCraftGui(g) then pcall(HideGui, g) end
    end
end

local function RestoreCraftGuis()
    CraftGuiUntil = 0
    for g in pairs(HiddenGuis) do
        pcall(function() if g.Parent then g.Enabled = true end end)
    end
    HiddenGuis = {}
end

pcall(function()
    LocalPlayer:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
        if HideCraftGui and os.clock() < CraftGuiUntil and IsCraftGui(child) then
            task.defer(function() pcall(HideGui, child) end)
        end
    end)
end)

-- the client-side machine stage (3D "put pets in" scene): no-op while we craft (best effort)
pcall(function()
    local mod = ReplicatedStorage:FindFirstChild("Modules")
    mod = mod and mod:FindFirstChild("Client")
    mod = mod and mod:FindFirstChild("Pets")
    mod = mod and mod:FindFirstChild("GoldenMachineStage")
