local function HideCraftGuisNow()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, g in ipairs(pg:GetChildren()) do
        if IsCraftGui(g) then pcall(HideGui, g) end
    end
end

local function RestoreCraftGuis()
    for g in pairs(HiddenGuis) do
        pcall(function() if g.Parent then g.Enabled = true end end)
    end
    HiddenGuis = {}
end

pcall(function()
    LocalPlayer:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
        if HideCraftGui and os.clock() < CraftGuiUntil and IsCraftGui(child) then
            task.defer(function() pcall(HideGui, child) end)
        end
    end)
end)

-- the client-side machine stage (the 3D "put pets in" scene): make its Play/Start a no-op while we craft (best effort)
pcall(function()
    local mod = ReplicatedStorage:FindFirstChild("Modules")
    mod = mod and mod:FindFirstChild("Client")
    mod = mod and mod:FindFirstChild("Pets")
    mod = mod and mod:FindFirstChild("GoldenMachineStage")
    if not mod then return end
    local stage = require(mod)
    if type(stage) ~= "table" then return end
    for name, fn in pairs(stage) do
        if type(fn) == "function" and string.find(string.lower(name), "play") or string.find(string.lower(tostring(name)), "show") or string.find(string.lower(tostring(name)), "start") then
            stage[name] = function(...)
                if HideCraftGui and os.clock() < CraftGuiUntil then return nil end
                return fn(...)
            end
        end
    end
end)

local function Craft(machine, ids)
    if HideCraftGui then
        CraftGuiUntil = os.clock() + 15
        HideCraftGuisNow()
    end
    InOwnCall = true
    local ok, err = pcall(function()
        MachineEvent:FireServer({
            PetIds = ids,
            Machine = machine,
            Action = "Craft",
        })
    end)
    InOwnCall = false
    return ok, err
end

local CraftGap, LastCraftOkAt = 2.5, -1e9 -- seconds between crafts (grows when the machine is busy)
local BadUntil = {} -- [machine .. key] = os.clock() until which a rejected group is skipped
local LastStatus = ""

-- returns true when a craft was consumed by the server, false + reason otherwise
local function TryCraft(machine)
    local groups, info, store = GetPetGroups(machine)
    if type(groups) ~= "table" then return false, tostring(info) end
    local learned = LearnedByMachine[machine]
    local need = (learned and learned.need) or GetRequiredCount(machine)
    local bestKey, bestIds
    for key, ids in pairs(groups) do
        if #ids >= need and (BadUntil[machine .. key] or 0) < os.clock() then
            if not bestIds or #ids > #bestIds then bestKey, bestIds = key, ids end
        end
    end
    if not bestIds then
        local bestN, bestT = 0, "?"
        for key, ids in pairs(groups) do
            if #ids > bestN then bestN, bestT = #ids, key end
        end
        return false, string.format("no complete set: best group %s has %d/%d", bestT, bestN, need)
    end
    local use = {}
    for i = 1, need do use[i] = bestIds[i] end
    if TeleportToMachine then
        local okNear, whyNear = GoNearMachine(machine)
        if not okNear then return false, tostring(whyNear) end
        PressMachinePrompt(machine)
    end
    local ok, err = Craft(machine, use)
    if not ok then return false, "FireServer error: " .. tostring(err) end
    -- the replica updates a moment after the server accepted the craft: poll up to 3 s before deciding it was refused
    local consumed = false
    for _ = 1, 12 do
        task.wait(0.25)
        local data = GetReplicaData()
        local st = (data and PetStorePath and Resolve(data, PetStorePath)) or store
        if st and not PetExists(st, use[1]) then consumed = true break end
    end
    if not consumed then
        local sinceOk = os.clock() - LastCraftOkAt
        if sinceOk < 20 then
            -- right after a successful craft the machine is probably still busy (animation): wait longer, do not blacklist the set
            CraftGap = math.min(CraftGap * 1.5, 12)
            return false, string.format("machine busy after the last craft, waiting %.1fs", CraftGap)
        end
        BadUntil[machine .. bestKey] = os.clock() + 120
        local hrp = GetHrp()
        local mp = MachineSpots[machine] and MachineSpots[machine].Position or MachinePos(machine)
        local dist = (hrp and mp) and math.floor((hrp.Position - mp).Magnitude) or -1
        return false, "server did not take the set " .. bestKey .. " (distance to machine: " .. dist .. " studs; skipping it for 2 min)"
    end
    LastCraftOkAt = os.clock()
    return true, bestKey
end

