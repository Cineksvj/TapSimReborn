local function GetEggOptions()
    local names, seen = {}, {}
    local function add(n)
        if type(n) == "string" and #n > 0 and not seen[n] then
            seen[n] = true
            table.insert(names, n)
        end
    end
    local module = WaitForPath({"Shared", "Pets", "LaunchEggConfig"}, 5)
    if module then
        local ok, cfg = pcall(require, module)
        if ok and type(cfg) == "table" then
            local roots = { cfg }
            if type(cfg.Eggs) == "table" then table.insert(roots, cfg.Eggs) end
            if type(cfg.GetEggs) == "function" then
                local ok2, res = pcall(cfg.GetEggs)
                if ok2 and type(res) == "table" then table.insert(roots, res) end
            end
            for _, root in ipairs(roots) do
                for k, v in pairs(root) do
                    if type(k) == "string" and type(v) == "table"
                        and (v.Price ~= nil or v.Cost ~= nil or v.Pets ~= nil
                            or v.Weight ~= nil or v.Weights ~= nil
                            or v.Currency ~= nil or v.Order ~= nil) then
                        add(k)
                    end
                end
                for _, v in ipairs(root) do
                    if type(v) == "table" and type(v.Name) == "string" then
                        add(v.Name)
                    end
                end
            end
            if #names == 0 then
                for _, root in ipairs(roots) do
                    for k, v in pairs(root) do
                        if type(k) == "string" and type(v) == "table" then add(k) end
                    end
                end
            end
        end
    end
    add("Crystal")
    table.sort(names)
    return names
end

