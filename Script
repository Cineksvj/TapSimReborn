-- ═══════════ EGG + GOLD LOOP ═══════════
-- Open eggs -> storage has fewer free slots than one hatch needs -> stop, teleport to the machine, craft ALL sets,
-- teleport back to the egg, keep opening. Repeats forever. Stops (with a notification) only if the storage is full
-- and there is nothing left to craft, so it can never ping-pong without progress.
local GoldThreshold = 0.9

Main:CreateDropdown({
    Name = "Gold-only mode starts at (inventory %)",
    Options = { "70%", "80%", "90%", "95%" },
    CurrentOption = { "90%" },
    MultipleOptions = false,
    Flag = "GoldThreshold",
    Callback = function(Option)
        GoldThreshold = (tonumber(string.match(Option[1] or "90%", "%d+")) or 90) / 100
    end,
})

local InvLabel = Main:CreateLabel("Inventory: unknown")
local function SetInv(text) pcall(function() InvLabel:Set(text) end) end

Main:CreateButton({
    Name = "Check inventory",
    Callback = function()
        local n, limit = Storage()
        if not n then SetInv("Inventory: data not ready") return end
        SetInv(string.format("Inventory: %d/%d (%d free) | craftable sets: %d", n, limit, limit - n, CountSets(SelectedMachine)))
    end,
})

local LoopToken = 0
local LoopToggle, GoldToggle

local function RunLoop(manageEgg, toggle)
    LoopToken += 1
    local myToken = LoopToken
    local function alive() return myToken == LoopToken end
    local function stopSelf(reason)
        if reason then Notify("Stopped", reason) SetStatus(reason) end
        if alive() then LoopToken += 1 end
        pcall(function() toggle:Set(false) end)
    end

    task.spawn(function()
        local hrp0 = GetHrp()
        local home = SavedEggSpot or (hrp0 and hrp0.CFrame)
        while alive() do
            local n, limit = Storage()
            if not n then
                SetStatus("waiting for pet data")
                task.wait(1)
            else
                local free = limit - n
                SetInv(string.format("Inventory: %d/%d (%d free)", n, limit, free))
                local needCraft
                if manageEgg then needCraft = free < HatchCount
                else needCraft = (n / limit) >= GoldThreshold end

                if not needCraft then
                    if manageEgg then
                        local hrp = GetHrp()
                        if home and hrp and (hrp.Position - home.Position).Magnitude > 12 then
                            TeleportTo(home, 0.3)
                        end
                        StartEgg()
                        SetStatus(string.format("opening eggs (%d/%d)", n, limit))
                    else
                        SetStatus(string.format("waiting for %d%% (now %d%%)", GoldThreshold * 100, math.floor(n / limit * 100)))
                    end
                    task.wait(manageEgg and 0.15 or 1.5)
                else
                    if manageEgg then StopEgg() task.wait(1.2) end -- let the hatches in flight land first
                    if CountSets(SelectedMachine) == 0 then
                        if manageEgg then
                            stopSelf("Storage full and nothing to craft")
                            break
                        end
                        SetStatus("full but no complete set to craft")
                        task.wait(3)
                    else
                        SetStatus("storage full: crafting")
                        local crafted, why = CraftAll(SelectedMachine, alive)
                        if home and alive() then TeleportTo(home, 0.4) end
                        if crafted == 0 and alive() then
                            stopSelf("Craft failed: " .. tostring(why))
                            break
                        end
                    end
                end
            end
        end
        if manageEgg then StopEgg() end
        RestoreCraftGuis()
    end)
end

