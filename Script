local UidFields = { "Uid", "UUID", "PetUid", "Guid", "Id" }
local function PetUid(key, pet)
    if IsUuid(key) then return key end
    if type(pet) == "table" then
        for _, f in ipairs(UidFields) do
            if IsUuid(pet[f]) then return pet[f] end
        end
    end
    return nil
end

-- the replica data of the player (DataController wraps a Madwork replica)
local function GetReplicaData()
    local ok, dc = pcall(function()
        return require(ReplicatedStorage.Controllers.Core.DataController)
    end)
    if not ok or type(dc) ~= "table" then return nil, "no DataController" end
    local getters = {
        function() return dc:GetReplica() end,
        function() return dc.Replica end,
        function() return dc.replica end,
        function() return dc:Get() end,
        function() return dc:GetData() end,
        function() return dc.Data end,
    }
    for _, g in ipairs(getters) do
        local ok2, r = pcall(g)
        if ok2 and type(r) == "table" then
            if type(r.Data) == "table" then return r.Data end
            local n = 0
            for _ in pairs(r) do n += 1 if n > 3 then break end end
            if n > 3 then return r end
        end
    end
    return nil, "replica not ready (data still loading?)"
end

local function Resolve(root, path)
    local cur = root
    for _, k in ipairs(path) do
        if type(cur) ~= "table" then return nil end
        cur = cur[k]
    end
    return type(cur) == "table" and cur or nil
end

-- finds the table that holds the pets: it contains the wanted uuids (learned craft) or mostly uuid entries
local function FindStore(data, wantIds)
    local best, bestPath, bestScore = nil, nil, 0
    local visited = {}
    local function dfs(t, path, depth)
        if depth > 5 or visited[t] then return end
        visited[t] = true
        local total, ids, hit = 0, 0, 0
        for k, v in pairs(t) do
            total += 1
            if total > 5000 then break end
            local u = PetUid(k, v)
            if u then
                ids += 1
                if wantIds and wantIds[u] then hit += 1 end
            end
        end
        local score = 0
        if wantIds then
            if hit > 0 then score = hit * 100000 + ids end
        elseif ids >= 4 and ids >= total * 0.8 then
            score = ids
        end
        if score > bestScore then
            best, bestPath, bestScore = t, table.clone(path), score
        end
        for k, v in pairs(t) do
            if type(v) == "table" then
                table.insert(path, k)
                dfs(v, path, depth + 1)
                table.remove(path)
            end
        end
    end
    dfs(data, {}, 0)
    return best, bestPath
end

