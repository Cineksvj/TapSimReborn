-- ═══════════ EGG SPEED ═══════════
-- Seq continues the game's own counter (learned by the hook) so the server does not drop our requests as old ones.
-- Count stays at the 8 you own (a bigger Count would bypass the paid x8 gamepass, so it is not used).
-- Auto-tune: with Auto Open ON it tries 1,2,3,5,8,12,20 requests per frame, measures how many pets you really gain per second
-- and keeps the best level (the server has its own limit, more is not always faster).
local TuneRunning = false
Main:CreateToggle({
    Name = "Auto-tune egg open speed (turn on Auto Open first)",
    CurrentValue = false,
    Flag = "EggTune",
    Callback = function(Value)
        TuneRunning = Value
        if not Value then return end
        task.spawn(function()
            local levels = { 1, 2, 3, 5, 8, 12, 20 }
            while TuneRunning do
                local bestRate, bestLevel = -1, BURST_PER_FRAME
                for _, lv in ipairs(levels) do
                    if not TuneRunning then break end
                    BURST_PER_FRAME = lv
                    local n0 = CountPets()
                    task.wait(5)
                    local n1 = CountPets()
                    local rate = (n0 and n1) and (n1 - n0) / 5 or 0
                    print(string.format("[Tune] burst %d -> %.1f pets/s", lv, rate))
                    if rate > bestRate * 1.05 then bestRate, bestLevel = rate, lv end
                end
                BURST_PER_FRAME = bestLevel
                SetInv(string.format("Egg open speed: best burst %d (%.1f pets/s)", bestLevel, bestRate))
                for _ = 1, 60 do
                    if not TuneRunning then break end
                    task.wait(1)
                end
            end
        end)
    end,
})

local function Ser(v, depth)
    depth = depth or 0
    if type(v) ~= "table" then return tostring(v) end
    if depth >= 2 then return "{...}" end
    local out = {}
    for k, x in pairs(v) do
        out[#out + 1] = tostring(k) .. "=" .. Ser(x, depth + 1)
        if #out >= 14 then out[#out + 1] = "..." break end
    end
    return "{" .. table.concat(out, ", ") .. "}"
end

