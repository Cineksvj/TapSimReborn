local ManualCap = 0
local CapWords = { "cap", "max", "limit", "slot", "size" }
local InvWords = { "pet", "inventory", "storage", "backpack", "bag" }
local function HasAny(s, words)
    for _, w in ipairs(words) do
        if string.find(s, w, 1, true) then return true end
    end
    return false
end

local function CountPets()
    local data = GetReplicaData()
    if not data then return nil end
    local store = PetStorePath and Resolve(data, PetStorePath)
    if not store then
        store, PetStorePath = FindStore(data, nil)
    end
    if not store then return nil, data end
    local n = 0
    for k, v in pairs(store) do
        if PetUid(k, v) then n += 1 end
    end
    return n, data
end

-- capacity: manual value, else the game's InventoryController, else a numeric field like "MaxPets"/"InventorySize" in the data
local function FindCap(data, count)
    if ManualCap > 0 then return ManualCap end
    local ok, ic = pcall(function() return require(ReplicatedStorage.Controllers.Pets.InventoryController) end)
    if ok and type(ic) == "table" then
        for _, name in ipairs({ "GetCapacity", "GetMaxPets", "GetMax", "GetLimit", "GetInventorySize", "GetMaxSize" }) do
            if type(ic[name]) == "function" then
                local ok2, v = pcall(ic[name], ic)
                if ok2 and type(v) == "number" and v >= count and v < 1e6 then return v end
            end
        end
    end
    local best = nil
    local visited = {}
    local function dfs(t, depth)
        if depth > 3 or visited[t] then return end
        visited[t] = true
        for k, v in pairs(t) do
            if type(k) == "string" and type(v) == "number" then
                local lk = string.lower(k)
                if HasAny(lk, CapWords) and HasAny(lk, InvWords) and v >= count and v < 1e6 then
                    if not best or v > best then best = v end
                end
            elseif type(v) == "table" and not IsUuid(k) then
                dfs(v, depth + 1)
            end
        end
    end
    if data then dfs(data, 0) end
    return best
end

local function InvFill()
    local n, data = CountPets()
    if not n then return nil end
    local cap = FindCap(data, n)
    if not cap then return n, nil, nil end
    return n, cap, n / cap
end

