-- hook: learn the game's own hatch counter (Seq) so our requests continue it
pcall(function()
    if not (EggEvent and hookmetamethod and getnamecallmethod) then return end
    local wrap = newcclosure or function(f) return f end
    local old
    old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if self == EggEvent and getnamecallmethod() == "FireServer" then
            local args = ...
            if not InOwnHatch and type(args) == "table" and type(args.Seq) == "number" and args.Seq > LastClientSeq then
                LastClientSeq = args.Seq
            end
        end
        return old(self, ...)
    end))
end)
-- ═══════════ PET DATA / STORAGE ═══════════
-- Real layout (from the game's own code): Data.Pets.Owned[uid] = { Name, Tier, Locked, Frozen, ... },
-- Data.Pets.Equipped = { uid, ... }, Data.Pets.StorageLimit = max pets. A hatch needs `Count` free slots (else "StorageFull").
local function Ser(v, depth)
    depth = depth or 0
    if type(v) ~= "table" then return tostring(v) end
    if depth >= 2 then return "{...}" end
    local out = {}
    for k, x in pairs(v) do
        out[#out + 1] = tostring(k) .. "=" .. Ser(x, depth + 1)
        if #out >= 14 then out[#out + 1] = "..." break end
    end
    return "{" .. table.concat(out, ", ") .. "}"
end

local DataControllerModule = nil
local function GetData()
    if not DataControllerModule then
        local ok, dc = pcall(function() return require(ReplicatedStorage.Controllers.Core.DataController) end)
        if not ok or type(dc) ~= "table" then return nil end
        DataControllerModule = dc
    end
    local ok, rep = pcall(function() return DataControllerModule:GetReplica() end)
    if ok and type(rep) == "table" and type(rep.Data) == "table" and type(rep.Data.Pets) == "table" then
        return rep.Data
    end
    return nil
end

-- returns owned count, storage limit
local function Storage()
    local data = GetData()
    if not data or type(data.Pets.Owned) ~= "table" then return nil end
    local n = 0
    for _ in pairs(data.Pets.Owned) do n += 1 end
    return n, tonumber(data.Pets.StorageLimit) or 150
end

