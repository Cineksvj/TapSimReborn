    if text == LastStatusText then return end
    LastStatusText = text
    print("[Status] " .. text)
    pcall(function() StatusLabel:Set("Status: " .. text) end)
end

local function IslandUnlocked(data, island)
    if island == "Spawn" or island == nil then return true end
    local p = data and data.Progression
    return type(p) == "table" and type(p.UnlockedIslands) == "table" and p.UnlockedIslands[island] == true
end

local function TravelTo(island)
    if island == nil or CurrentIsland() == island then return true end
    Status("travelling to " .. island .. " (now on " .. tostring(CurrentIsland()) .. ")")
    local travel = RF("IslandService", "Travel")
    if not travel then Status("IslandService.RF.Travel remote not found") return false end
    local r = Invoke(travel, { Island = island, Source = "Menu" })
    if island == "Spawn" and not (type(r) == "table" and r.Success) then
        r = Invoke(travel, { ReturnToSpawn = true, Source = "Menu" })
    end
    print("[Travel] -> " .. island .. ": " .. Dump(r))
    for _ = 1, 80 do
        if CurrentIsland() == island then
            Status("arrived on " .. island .. ", waiting for it to load")
            task.wait(2) -- let the island stream in
            return true
        end
        task.wait(0.25)
    end
    Status("travel to " .. island .. " failed: " .. Dump(r) .. " (still on " .. tostring(CurrentIsland()) .. ")")
    return false
end

-- waits for something to show up after a teleport (streaming); finder() returns the object or nil
local function WaitFor(finder, seconds)
    local t0 = os.clock()
    repeat
        local obj = finder()
        if obj then return obj end
        task.wait(0.25)
    until os.clock() - t0 > (seconds or 10)
    return nil
end

local function Island(name) -- workspace.Ts2Islands[name], once loaded
    local f = workspace:FindFirstChild("Ts2Islands")
    return f and f:FindFirstChild(name)
end

-- looks for something that lives on an unknown island: checks the current island, then travels through the
-- unlocked ones. finder() returns the object or nil. The island is cached under `key` once found.
local KnownIsland = { -- where things are known to be; anything else is searched once and remembered
    ["machine:Golden"] = "Shadow Realm",
    ["machine:Diamond"] = "Crystal Cave",
    ["machine:Rainbow"] = "Shadow Realm",
}
local function FindOnIslands(key, finder, timeoutEach)
    local obj = finder()
    if obj then KnownIsland[key] = CurrentIsland() return obj end
    local order = {}
    if KnownIsland[key] then table.insert(order, KnownIsland[key]) end
    local cur = CurrentIsland()
    for _, n in ipairs(ISLANDS) do if n ~= cur and n ~= KnownIsland[key] then table.insert(order, n) end end
    local data = GetData()
    for _, island in ipairs(order) do
        if (island == KnownIsland[key] or IslandUnlocked(data, island)) and TravelTo(island) then
            Status("looking for " .. key .. " on " .. island)
            obj = WaitFor(finder, timeoutEach or 6)
            if obj then KnownIsland[key] = island return obj end
        end
    end
    return nil
end

-- ═══════════ AUTO CRAFT: Golden -> Diamond -> Rainbow ═══════════
-- Storage nearly full (fewer free slots than one x8 hatch needs) -> pause the egg, then in this order, each step only
-- while the storage is STILL full after the previous one:
--   1. Golden machine: every set of 6 same Normal pets            (MachineCraftRequested Craft, Machine="Golden")
--   2. Diamond machine: every set of 5 same Golden pets           (Machine="Diamond")
--   3. Rainbow machine: claim finished pods, start pods with 5 same Diamond pets (Machine="Shiny", Start/Claim; 30 s each)
-- then teleport back to where you were and resume the egg. The crafting menus/cutscenes are kept closed meanwhile.
local MenuController
pcall(function() MenuController = require(ReplicatedStorage.Controllers.UI.MenuController) end)

local STAGES = {
    { machine = "Golden",  point = "Golden",  tier = "Normal", need = 6 },
    { machine = "Diamond", point = "Diamond", tier = "Golden", need = 5 },
}
local RAINBOW = { machine = "Shiny", point = "Rainbow", tier = "Diamond", need = 5, maxQueue = 3 }

-- pets of one tier grouped by name, skipping locked / frozen / equipped ones
local function GetGroups(tier)
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local equipped = {}
    for _, id in ipairs(data.Pets.Equipped or {}) do equipped[id] = true end
    local groups = {}
    for id, pet in pairs(data.Pets.Owned) do
        if type(pet) == "table" and pet.Tier == tier and pet.Locked ~= true and pet.Frozen == nil
            and not equipped[id] and type(pet.Name) == "string" then
            local g = groups[pet.Name]
            if not g then g = {} groups[pet.Name] = g end
            table.insert(g, id)
        end
    end
    return groups
end

-- the biggest complete set for a stage, or nil
local function PickSet(stage)
    local groups = GetGroups(stage.tier)
    if not groups then return nil end
    local best
    for _, ids in pairs(groups) do
        if #ids >= stage.need and (not best or #ids > #best) then best = ids end
    end
    if not best then return nil end
    local use = {}
    for i = 1, stage.need do use[i] = best[i] end
    return use
end

local function Full()
    local n, limit = Storage()
    return n ~= nil and limit - n < HatchCount()
end

-- the circle you stand on to open a machine: a part tagged "InteractionPoint" named Golden / Diamond / Rainbow.
-- We stand at its middle ON THE FLOOR (ray down from the middle), not at the middle of its box.
local function MachineTarget(pointName)
    local hrp = GetHrp()
    local best, bestDist
    for _, p in ipairs(CollectionService:GetTagged("InteractionPoint")) do
        if p.Name == pointName then
            local cf, size
            if p:IsA("BasePart") then cf, size = p.CFrame, p.Size
            elseif p:IsA("Model") then cf, size = p:GetBoundingBox() end
            if cf then
                local d = hrp and (hrp.Position - cf.Position).Magnitude or 0
                if not bestDist or d < bestDist then best, bestDist = { cf = cf, size = size }, d end
            end
        end
    end
    if not best then return nil end
    local pos = best.cf.Position
    local y = pos.Y - best.size.Y / 2 + 3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local hit = workspace:Raycast(pos, Vector3.new(0, -(best.size.Y / 2 + 12), 0), params)
    if hit then y = hit.Position.Y + 3 end
    return Vector3.new(pos.X, y, pos.Z)
end

local function TeleportTo(pos, settle)
    local hrp = GetHrp()
    if not hrp then return false end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos)
    task.wait(settle or 0.5)
    return true
end

-- the machines sit on different islands: travel to the right one (learned once), then stand on the circle
local MachineSkipUntil = {}
local function GoTo(pointName)
    if (MachineSkipUntil[pointName] or 0) > os.clock() then return false end
    local target = FindOnIslands("machine:" .. pointName, function() return MachineTarget(pointName) end, 6)
    local hrp = GetHrp()
    if not (target and hrp) then
        MachineSkipUntil[pointName] = os.clock() + 300
        warn("[Craft] " .. pointName .. " machine circle not found on any unlocked island; skipping it for 5 min")
        return false
    end
    if (hrp.Position - target).Magnitude > 2.5 then TeleportTo(target, 1.2) end -- 1.2 s so the server sees the move
    return true
end

-- after "You must be near the ... Machine": stand on the circle again and give the server time
local function ReGoTo(pointName)
    local target = MachineTarget(pointName)
    if target then TeleportTo(target + Vector3.new(0, 0.5, 0), 1.2) end
end

-- ── keep the crafting GUI closed while we craft ──
-- The game opens the machine menu whenever you stand on the circle and the "CraftingRoll" menu on every result, and each
-- menu open/close hides and shows the whole HUD through HudController. Forcing the ScreenGuis off every frame fought
-- that and left the HUD hidden. Now MenuController.Open is simply ignored for the crafting menus while a trip runs, and
-- the HUD is explicitly shown again when the trip ends.
local HudController
pcall(function() HudController = require(ReplicatedStorage.Controllers.UI.HudController) end)
local CRAFT_MENUS = { "Golden", "Diamond", "CraftingRoll", "RainbowFuse", "RainbowMachine", "RainbowCraft", "GoldenBulk", "DiamondOld" }
local CraftMenuSet = {}
for _, n in ipairs(CRAFT_MENUS) do CraftMenuSet[n] = true end
local Hiding = false

pcall(function()
    if type(MenuController) ~= "table" or type(MenuController.Open) ~= "function" or table.isfrozen(MenuController) then return end
    local realOpen = MenuController.Open
    MenuController.Open = function(self, name, ...)
        if Hiding and CraftMenuSet[name] then return end
        return realOpen(self, name, ...)
    end
end)

-- the crafting cutscenes / glow / 3D stage are client-only: make them no-ops while a trip runs
pcall(function()
    local function stub(path, names)
        local obj = ReplicatedStorage
        for _, n in ipairs(path) do obj = obj:FindFirstChild(n) if not obj then return end end
        local m = require(obj)
        if type(m) ~= "table" or table.isfrozen(m) then return end
        for _, name in ipairs(names) do
            local real = m[name]
            if type(real) == "function" then
                m[name] = function(...)
                    if Hiding then return nil end
                    return real(...)
                end
            end
        end
    end
    stub({ "Modules", "Client", "Pets", "GoldenMachineStage" }, { "Begin", "Arm", "Resolve" })
    stub({ "Modules", "Client", "Pets", "DiamondMachineRig" }, { "Begin", "Arm", "Resolve" })
    stub({ "Modules", "Client", "Pets", "DiamondCraftCutscene" }, { "Begin" })
    stub({ "Modules", "Client", "Common", "ScreenGlow" }, { "Play" })
end)

-- HudController:SetHudHidden(true, reason) is what hides the HUD. During a trip every hide is swallowed (and the reason
-- remembered); when the trip ends each remembered reason is explicitly un-hidden, and the HUD ScreenGuis tagged
-- "HideDuringCutscene" are switched back on in case a cutscene disabled them directly.
local HudReasons, RealSetHudHidden = {}, nil
pcall(function()
    if type(HudController) ~= "table" or type(HudController.SetHudHidden) ~= "function" or table.isfrozen(HudController) then return end
    RealSetHudHidden = HudController.SetHudHidden
    HudController.SetHudHidden = function(self, hidden, reason, ...)
        local key = reason or "Gameplay"
        if Hiding and hidden then
            HudReasons[key] = true
            return
        end
        if not hidden then HudReasons[key] = nil end
        return RealSetHudHidden(self, hidden, reason, ...)
    end
end)

-- upvalues of a game function (executor debug library), or {} when not available
local function Upvalues(f)
    local ok, t = pcall(function() return debug.getupvalues(f) end)
    if ok and type(t) == "table" then return t end
    local out = {}
    pcall(function()
        for i = 1, 60 do
            local n, v = debug.getupvalue(f, i)
            if n == nil then break end
            out[i] = v
        end
    end)
    return out
end

-- ScreenHide (Modules.Client.Common.ScreenHide) disables EVERY ScreenGui while a "hold" is active and re-disables
-- them when something turns them back on. A hold that is never released = the whole UI gone. This clears the
-- hold table and lets the module's own restore run (Hold() + release with an empty table calls restoreAll).
local ScreenHide
pcall(function() ScreenHide = require(ReplicatedStorage.Modules.Client.Common.ScreenHide) end)
local function ReleaseScreenHide()
    if not (ScreenHide and type(ScreenHide.IsActive) == "function" and ScreenHide.IsActive()) then return false end
    local holds
    for _, v in pairs(Upvalues(ScreenHide.Hold)) do
        if type(v) == "table" then
            for k, x in pairs(v) do
                if type(k) == "string" and type(x) == "table" and x.HideNew ~= nil then holds = v break end
            end
        end
        if holds then break end
    end
    if not holds then warn("[UI] ScreenHide is active but its hold table was not found (no debug.getupvalues?)") return false end
    local names = {}
    for k in pairs(holds) do table.insert(names, k) holds[k] = nil end
    local ok, release = pcall(ScreenHide.Hold, "CorvusRestore")
    if ok and type(release) == "function" then pcall(release) end
    warn("[UI] released stale screen hides: " .. table.concat(names, ", "))
    return true
end
-- watchdog: a screen hide that lasts more than 20 s is stale (cutscenes take a few seconds)
task.spawn(function()
    local since
    while not Killed do
        task.wait(2)
        local active = false
        pcall(function() active = ScreenHide and ScreenHide.IsActive() end)
        if active then
            since = since or os.clock()
            if os.clock() - since > 20 then ReleaseScreenHide() since = nil end
        else
            since = nil
        end
    end
end)

local function ShowHud()
    pcall(function()
        if not HudController then return end
        local set = RealSetHudHidden or HudController.SetHudHidden
        HudReasons.Menu = true
        for reason in pairs(HudReasons) do pcall(set, HudController, false, reason) end
        HudReasons = {}
        -- reasons set through a cached reference never reach the wrapper: read the controller's own reason table
        for _, v in pairs(Upvalues(set)) do
            if type(v) == "table" then
                local plain, any = true, false
                for k, x in pairs(v) do any = true if type(k) ~= "string" or x ~= true then plain = false break end end
                if plain and any then for k in pairs(v) do pcall(set, HudController, false, k) end end
            end
        end
    end)
    pcall(function()
        for _, g in ipairs(CollectionService:GetTagged("HideDuringCutscene")) do
            if g:IsA("ScreenGui") and not g.Enabled then g.Enabled = true end
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local game_ = pg and pg:FindFirstChild("Game")
        if game_ then
            game_:SetAttribute("TS2HudHidden", false)
            game_:SetAttribute("TS2MenuHudHidden", false)
        end
    end)
end

local HideGen = 0
local function StartHiding()
    HideGen += 1 -- cancels a pending un-hide from the previous trip
    Hiding = true
    if MenuController then
        for _, n in ipairs(CRAFT_MENUS) do pcall(MenuController.Close, MenuController, n) end
    end
end

-- The roll animation of the last craft keeps running for several seconds after the trip; its late menu opens and
-- cutscene calls must still be swallowed, so the block is lifted 15 s later and the HUD is shown again then.
local function StopHiding()
    HideGen += 1
    local gen = HideGen
    local function closeAll()
        if MenuController then
            for _, n in ipairs(CRAFT_MENUS) do pcall(MenuController.Close, MenuController, n) end
        end
    end
    closeAll()
    ShowHud()
    task.delay(1, function() if gen == HideGen then closeAll() ShowHud() end end)
    task.delay(15, function()
        if gen ~= HideGen then return end
        Hiding = false
        closeAll()
        ShowHud()
        ReleaseScreenHide()
        task.delay(1, function() if gen == HideGen then ShowHud() end end)
    end)
end

-- ── server answers ──
local ResultSeq, LastResult = 0, nil
if MachineResultEvent then
    MachineResultEvent.OnClientEvent:Connect(function(r)
        if type(r) == "table" then
            ResultSeq += 1
            LastResult = r
        end
    end)
end

-- fires one machine request and waits for the answer. `done()` returns true when the data shows it went through.
local function Request(args, done)
    local seq0 = ResultSeq
    local ok, err = pcall(function() MachineEvent:FireServer(args) end)
    if not ok then return false, tostring(err) end
    local t0 = os.clock()
    while os.clock() - t0 < 6 and ResultSeq == seq0 do
        if done and done() then return true end
        task.wait(0.05)
    end
    if ResultSeq > seq0 then
        if LastResult.Success == true then return true end
        return false, tostring(LastResult.Error or LastResult.Message or LastResult.Reason or "refused")
    end
    if done and done() then return true end
    return false, "no answer from the server"
end

local function PetsGone(ids)
    return function()
        local data = GetData()
        return data ~= nil and data.Pets.Owned[ids[1]] == nil
    end
end

-- crafts every complete set of one stage; returns how many went through
local function CraftStage(stage)
    if not PickSet(stage) then return 0 end
    Status("craft: going to the " .. stage.machine .. " machine")
    if not GoTo(stage.point) then return 0 end
    Status("craft: " .. stage.machine)
    local crafted, fails = 0, 0
    local t0, lastFirst = os.clock(), nil
    while os.clock() - t0 < 120 and not Killed do
        local use = PickSet(stage)
        if not use then break end
        if use[1] == lastFirst then
            -- the server said ok but the pets are still in the data: do not loop on the same set forever
            task.wait(1)
            use = PickSet(stage)
            if not use or use[1] == lastFirst then warn("[Craft] " .. stage.machine .. ": pet data did not update after the craft, stopping") break end
        end
        local ok, why = Request({ PetIds = use, Machine = stage.machine, Action = "Craft" }, PetsGone(use))
        if ok then
            crafted += 1
            fails = 0
            lastFirst = use[1]
            Status(string.format("craft: %s #%d", stage.machine, crafted))
            task.wait(0.35)
        else
            fails += 1
            warn("[Craft] " .. stage.machine .. ": " .. tostring(why))
            if fails >= 4 then break end
            task.wait(math.min(0.5 * 2 ^ (fails - 1), 4))
            ReGoTo(stage.point)
        end
    end
    return crafted
end

-- rainbow pods: Data.Machines.Shiny.Queue[craftId] = { Name, PetCount, EndTime }
local function RainbowQueue()
    local data = GetData()
    local m = data and data.Machines and data.Machines.Shiny
    return (m and type(m.Queue) == "table") and m.Queue or nil
end

local function RainbowReadyIds()
    local q = RainbowQueue()
    local ready, total, now = {}, 0, workspace:GetServerTimeNow()
    for id, entry in pairs(q or {}) do
        total += 1
        if type(entry) == "table" and type(entry.EndTime) == "number" and entry.EndTime <= now then table.insert(ready, id) end
    end
    return ready, total
end

-- claims finished pods and starts new ones with 5 same Diamond pets (30 s each); returns pets removed from storage
local function CraftRainbow()
    local ready, total = RainbowReadyIds()
    local canStart = total - #ready < RAINBOW.maxQueue and PickSet(RAINBOW) ~= nil
    if #ready == 0 and not canStart then return 0 end
    if not GoTo(RAINBOW.point) then return 0 end
    for _, id in ipairs(ready) do
        local ok, why = Request({ Machine = "Shiny", Action = "Claim", CraftId = id }, function()
            local q = RainbowQueue()
            return q ~= nil and q[id] == nil
        end)
        if not ok then warn("[Craft] Rainbow claim: " .. tostring(why)) end
        task.wait(0.35)
    end
    local removed, fails = 0, 0
    while true do
        local _, queued = RainbowReadyIds()
        if queued >= RAINBOW.maxQueue then break end
        local use = PickSet(RAINBOW)
        if not use then break end
        local ok, why = Request({ PetIds = use, Machine = "Shiny", Action = "Start" }, PetsGone(use))
        if ok then
            removed += #use
            fails = 0
            task.wait(0.35)
        else
            fails += 1
            warn("[Craft] Rainbow start: " .. tostring(why))
            if fails >= 3 then break end
            task.wait(1)
        end
    end
    return removed
end

-- ── storage planning ──
-- A crafting trip costs ~20 s of hatching, so it is only worth it when it frees enough slots. Slots a trip would free:
-- Golden sets (6 -> 1 = 5 slots), Diamond sets (5 -> 1 = 4), Rainbow pods (5 pets leave the storage).
local function Freeable()
    local n = 0
    local g = GetGroups("Normal") or {}
    for _, ids in pairs(g) do n += math.floor(#ids / 6) * 5 end
    local d = GetGroups("Golden") or {}
    for _, ids in pairs(d) do n += math.floor(#ids / 5) * 4 end
    local ready, total = RainbowReadyIds()
    local pods = RAINBOW.maxQueue - (total - #ready)
    local r = GetGroups("Diamond") or {}
    for _, ids in pairs(r) do
        if pods <= 0 then break end
        if #ids >= 5 then n += 5 pods = pods - 1 end
    end
    return n
end

-- Junk: Normal-tier pets of Common / Rare rarity whose name group cannot complete a Golden set (fewer than 6).
-- They are the first to go when the storage is saturated, smallest groups first; Golden / Diamond / locked / equipped
-- pets and rarer names are never touched. Deletion uses the game's own PetDeleteRequest (batched, rate-limited).
local PetDeleteRequest = Req({ "Modules", "Client", "Pets", "PetDeleteRequest" })
local OriginalPetCatalog = Req({ "Shared", "Pets", "OriginalPetCatalog" })
local JUNK_RARITY = { Common = 1, Rare = 2 }
local function RarityOf(name)
    local c = OriginalPetCatalog and OriginalPetCatalog[name]
    return (type(c) == "table" and c.Rarity) or "?"
end
local JunkCleanup = true

local function DeleteIds(ids)
    if #ids == 0 then return end
    local ok = false
    if PetDeleteRequest and type(PetDeleteRequest.Send) == "function" then
        ok = pcall(PetDeleteRequest.Send, ids, true)
    end
    if not ok and PetEvent then
        for i = 1, #ids, 100 do
            PetEvent:FireServer({ Action = "Delete", PetIds = { table.unpack(ids, i, math.min(i + 99, #ids)) }, Batch = i })
            task.wait(1.1)
        end
    end
end

-- frees slots until `target` are free; returns how many pets were deleted
local function DeleteJunk(target)
    local groups = GetGroups("Normal")
    if not groups then return 0 end
    local list = {}
    for name, ids in pairs(groups) do
        local rank = JUNK_RARITY[RarityOf(name)]
        if rank and #ids < 6 then table.insert(list, { name = name, ids = ids, rank = rank }) end
    end
    table.sort(list, function(a, b) if a.rank ~= b.rank then return a.rank < b.rank end return #a.ids < #b.ids end)
    local n, limit = Storage()
    if not n then return 0 end
    local need = target - (limit - n)
    local todo = {}
    for _, g in ipairs(list) do
        if need <= 0 then break end
        for _, id in ipairs(g.ids) do
            if need <= 0 then break end
            table.insert(todo, id)
            need = need - 1
        end
    end
    if #todo == 0 then return 0 end
    Status(string.format("storage: deleting %d junk pets (Common/Rare normals that cannot make a set)", #todo))
    DeleteIds(todo)
    for _ = 1, 20 do -- wait for the data to catch up
        task.wait(0.5)
        local n2 = Storage()
        if n2 and n2 <= n - #todo + 2 then break end
    end
    return #todo
end

local CraftToken = 0
Main:CreateToggle({
    Name = "Auto Craft (Golden > Diamond > Rainbow)",
    CurrentValue = false,
    Callback = function(Value)
        CraftToken += 1
        local my = CraftToken
        if not Value then return end
        if not MachineEvent then warn("[Craft] remote not found") return end
        task.spawn(function()
            local held = false
            while my == CraftToken and not Killed do
                if Full() then
                    if not held then HoldEgg(true) held = true end
                    task.wait(1.2) -- let hatches in flight land
                    local freeable = Freeable()
                    local n, limit = Storage()
                    local wantFree = math.max(HatchCount() * 4, math.floor((limit or 150) * 0.2))
                    if freeable < 10 and JunkCleanup and Acquire("craft", 30) then
                        -- a trip would free almost nothing: make room by deleting junk instead and keep hatching
                        Status(string.format("storage %d/%d: a trip would free only %d slots, cleaning junk", n or 0, limit or 0, freeable))
                        local deleted = DeleteJunk(wantFree)
                        Release("craft")
                        if deleted > 0 and not Full() then
                            HoldEgg(false) held = false
                            task.wait(1)
                        elseif deleted == 0 and freeable == 0 then
                            Status("storage saturated: nothing to craft and no junk to delete (lock fewer pets or buy storage)")
                            task.wait(20)
                        end
                    end
                    if not (my == CraftToken and Full()) then
                        -- room was made without a trip
                    elseif not Acquire("craft") then
                        task.wait(5)
                    elseif my ~= CraftToken then
                        Release("craft")
                        break
                    else
                        local hrp = GetHrp()
                        local home, homeIsland = hrp and hrp.Position, CurrentIsland()
                        StartHiding()
                        local did = 0
                        local okRun, err = pcall(function()
                            for _, stage in ipairs(STAGES) do
                                if my ~= CraftToken then break end
                                if Full() then did += CraftStage(stage) end
                            end
                            if my == CraftToken and Full() then did += CraftRainbow() end
                        end)
                        if not okRun then warn("[Craft] " .. tostring(err)) Status("craft error: " .. tostring(err)) end
                        -- still saturated after crafting everything: delete junk before going back to the egg
                        if my == CraftToken and JunkCleanup and Full() then
                            pcall(DeleteJunk, math.max(HatchCount() * 4, math.floor((Storage() and select(2, Storage()) or 150) * 0.2)))
                        end
                        if my == CraftToken then pcall(GoHome, homeIsland, home) end
                        StopHiding()
                        Release("craft")
                        if Full() then
                            task.wait(did == 0 and 20 or 2) -- nothing helped: wait, then re-check
                        elseif held then
                            HoldEgg(false) held = false
                        end
                    end
                else
                    if held then HoldEgg(false) held = false end
                    task.wait(0.15)
                end
            end
            if held then HoldEgg(false) end
            StopHiding()
        end)
    end,
})

Main:CreateToggle({
    Name = "Delete junk when storage is saturated (Common/Rare normals)",
    CurrentValue = false,
    Callback = function(Value) JunkCleanup = Value end,
})

-- ═══════════ EXTRA FEATURES (dig site, chests, shrine, breakables, mining, pet defense, duck, events) ═══════════
-- Everything below was read from the game's own client code; the server is not visible, so distance / timing rules are
-- the ones the client enforces. Each feature is one toggle; trips take the lock above and pause the egg meanwhile.
local TapSeq = 0
local function Tap()
    if not TapEvent then return end
    TapSeq += 1
    TapEvent:FireServer({ Auto = false, ClientSequence = TapSeq })
end

-- runs fn(alive) in a loop while the toggle is on; fn is called again every `every` seconds
local function LoopToggle(name, every, fn)
    local token = 0
    Main:CreateToggle({
        Name = name,
        CurrentValue = false,
        Callback = function(Value)
            token += 1
            local my = token
            if not Value then return end
            task.spawn(function()
                local function alive() return my == token and not Killed end
                while alive() do
                    local ok, err = pcall(fn, alive)
                    if not ok then warn("[" .. name .. "] " .. tostring(err)) Status(name .. " error: " .. tostring(err)) end
                    if alive() then task.wait(every) end
                end
            end)
        end,
    })
end

-- a trip: lock + pause the egg + come back to where you were (island first, then the exact spot).
-- While the egg opener is on, "home" is always the egg itself (see the egg keeper below).
local EggHome = nil -- { island = ..., pos = Vector3 }
local function GoHome(island, pos)
    if EggWanted and EggHome then island, pos = EggHome.island, EggHome.pos end
    if island and CurrentIsland() ~= island then TravelTo(island) end
    if pos then TeleportTo(pos + Vector3.new(0, 1, 0), 0.4) end
end

local function Trip(who, body)
    Status(who .. ": starting trip")
    if not Acquire(who) then return end
    HoldEgg(true)
    local hrp = GetHrp()
    local home, homeIsland = hrp and hrp.Position, CurrentIsland()
    local ok, err = pcall(body)
    if not ok then warn("[" .. who .. "] " .. tostring(err)) Status(who .. " error: " .. tostring(err)) end
    Status(who .. ": going back to " .. tostring(homeIsland))
    GoHome(homeIsland, home)
    HoldEgg(false)
    Release(who)
    Status(who .. ": done")
end

-- ── egg keeper: the Void egg is on Shadow Realm (LaunchEggConfig.Void.Island); if you are on another island or more
-- than 25 studs from it, or the server answers "TooFar", travel there and stand in front of the egg ──
local function EggIsland()
    local cfg = LaunchEggConfig and LaunchEggConfig[EGG]
    return (cfg and (cfg.Island or (cfg.Zone ~= "Spawn" and nil))) or "Spawn"
end

local function EggModel()
    local eggs = workspace:FindFirstChild("Eggs")
    return eggs and eggs:FindFirstChild(EGG)
end

local function EggStandPos(m)
    local cf = m:GetPivot()
    return cf.Position + cf.LookVector * 7 + Vector3.new(0, 2, 0)
end

local function GoToEgg()
    Status("egg: going to the " .. EGG .. " egg on " .. EggIsland())
    if not TravelTo(EggIsland()) then return false end
    local m = WaitFor(EggModel, 15)
    if not m then Status("egg: workspace.Eggs." .. EGG .. " not found on " .. tostring(CurrentIsland())) return false end
    local pos = EggStandPos(m)
    TeleportTo(pos, 0.8)
    EggHome = { island = CurrentIsland(), pos = pos }
    EggTooFar = false
    Status("egg: at the " .. EGG .. " egg")
    return true
end

task.spawn(function()
    while not Killed do
        task.wait(1)
        if EggWanted and BusyBy == nil then
            local m = EggModel()
            local hrp = GetHrp()
            local far = EggTooFar or CurrentIsland() ~= EggIsland() or not m
                or (hrp and (hrp.Position - EggStandPos(m)).Magnitude > 25)
            if far and Acquire("egg", 5) then
                HoldEgg(true)
                pcall(GoToEgg)
                HoldEgg(false)
                Release("egg")
                task.wait(2)
            end
        end
    end
end)

-- ── breakables: Void Crystal, Crystal Cluster, Glow Mushroom, ... (HoneyPot ingredients) ──
-- Breakables are hit by ordinary taps while you stand within TapRange (14 studs) of their edge. Your own island
-- breakable spawns when you come within 100 studs of its spot (workspace.IslandBreakableSpots has one Vector3
-- attribute per spot) and it is off cooldown (Data.IslandBreakables[spot] = ready time). It hops away when hit.
local IslandBreakableConfig = Req({ "Shared", "Game", "IslandBreakableConfig" })
local SPOT_ORDER = { "ShadowRelm", "CrystalCave", "Mushroom", "Desert", "Autumn", "SkyIsland" } -- Void Crystal first

local function SpotCfg(id)
    local spots = IslandBreakableConfig and IslandBreakableConfig.Spots
    if type(spots) ~= "table" then return nil end
    if type(spots[id]) == "table" then return spots[id] end
    for _, v in pairs(spots) do if type(v) == "table" and v.Id == id then return v end end
    return nil
end

local function BreakableUsable(m)
    if not (m:IsA("Model") and m:GetAttribute("BreakableBroken") ~= true and m:GetAttribute("BreakableDespawned") ~= true) then return false end
    local owner = m:GetAttribute("BreakableOwner")
    if owner ~= nil and owner ~= LocalPlayer.UserId then return false end
    return (m:GetAttribute("BreakableHealth") or 0) > 0
end

local function FindBreakable(typeMatch)
    for _, m in ipairs(CollectionService:GetTagged("Breakable")) do
        local t = m:GetAttribute("BreakableType")
        if type(t) == "string" and typeMatch(t) and BreakableUsable(m) then return m end
    end
    return nil
end

-- stands next to the breakable and taps it until it is gone; returns true when broken
local function BreakIt(m, alive)
    local t0 = os.clock()
    while alive() and m.Parent and os.clock() - t0 < 120 do
        if m:GetAttribute("BreakableBroken") == true or (m:GetAttribute("BreakableHealth") or 0) <= 0 then return true end
        local rest, size = m:GetAttribute("BreakableRest"), m:GetAttribute("BreakableSize")
        local hrp = GetHrp()
        if typeof(rest) == "CFrame" and typeof(size) == "Vector3" and hrp then
            local d = (hrp.Position - rest.Position) * Vector3.new(1, 0, 1)
            local horiz = math.max(d.Magnitude - math.max(size.X, size.Z) * 0.5, 0)
            local vert = math.abs(hrp.Position.Y - (rest.Position.Y - size.Y * 0.5))
            if horiz > 10 or vert > 10 then
                TeleportTo(rest.Position + Vector3.new(0, size.Y * 0.5 + 2, 0) + rest.LookVector * (math.max(size.X, size.Z) * 0.5 + 5), 0.25)
            end
            Tap()
        end
        task.wait(0.11) -- GameConfig.ClickFxInterval; server HitInterval 0.1
    end
    return false
end

