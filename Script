-- ═══════════ ONE TRIP AT A TIME ═══════════
-- every feature that moves the character (crafting, digging, chests, mining, ...) takes this lock first
local BusyBy, BusySince = nil, 0
local TRIP_LIMIT = 240 -- seconds a trip may hold the lock; after that the watchdog frees it
-- waits up to `maxWait` seconds (default 180) for the lock; returns false when it gave up
local function Acquire(who, maxWait)
    local t0, start = os.clock(), os.clock()
    while BusyBy ~= nil and BusyBy ~= who do
        if Killed then return false end
        if os.clock() - start > (maxWait or 180) then
            warn("[" .. who .. "] gave up waiting: " .. tostring(BusyBy) .. " kept the lock too long")
            return false
        end
        if os.clock() - t0 > 15 then warn("[" .. who .. "] waiting: " .. tostring(BusyBy) .. " is still busy") t0 = os.clock() end
        task.wait(0.2)
    end
    BusyBy, BusySince = who, os.clock()
    return true
end
local function Release(who)
    if BusyBy == who then BusyBy = nil end
end
-- watchdog: a trip that hangs (server never answers, loop that never ends) must not block everything else forever
task.spawn(function()
    while not Killed do
        task.wait(5)
        if BusyBy ~= nil and os.clock() - BusySince > TRIP_LIMIT then
            warn("[Watchdog] " .. tostring(BusyBy) .. " held the lock for " .. math.floor(os.clock() - BusySince) .. " s; freeing it")
            BusyBy = nil
            EggHolds = 0
        end
    end
end)

