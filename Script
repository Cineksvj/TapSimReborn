LoopToggle("Auto Dig Site", 5, function(alive)
    local data = GetData()
    if not (data and DigConfig and DigController) then warn("[Dig] DigConfig / DigController not found") return end
    local left, waitFor = 0, 0
    pcall(function() left, waitFor = DigConfig.Allowance(data.Digging or {}, os.time()) end)
    if (left or 0) <= 0 then Status(string.format("Dig: no digs left, %d min until reset", math.ceil((waitFor or 0) / 60))) return end
    Trip("dig", function()
        if not TravelTo("Autumn") then return end
        local zone = WaitFor(function()
            local site
            pcall(function() site = DigWorld and DigWorld.GetSite() end)
            local autumn = Island("Autumn")
            site = site or (autumn and autumn:FindFirstChild("Digsite"))
            return site and site:FindFirstChild("DigZone")
        end, 15)
        if not zone then warn("[Dig] dig site not found on Autumn") return end
        TeleportTo(zone.Position + Vector3.new(0, 2, 0), 0.8)
        local lastWhy, idle = nil, 0
        while alive() do
            local l = 0
            pcall(function() l = DigConfig.Allowance((GetData() or data).Digging or {}, os.time()) end)
            if (l or 0) <= 0 then print("[Dig] out of digs for this hour") break end
            local s = DigController:GetState()
            local fire = true
            if type(s) == "table" and type(s.Round) == "table" then
                -- "perfect" = cursor within the inner 40 % of the target (DigController uses Width * 0.4 / 2);
                -- the hit time is passed to the server, so this is exact, not latency-dependent
                local now = Now()
                local r = s.Round
                local ok, d = pcall(function() return math.abs(DigConfig.Cursor(r, now) - r.Center) end)
                fire = ok and now >= (r.Epoch or 0) and d <= r.Width * 0.4 / 2 * 0.85
            end
            if fire then
                local r = DigController:Activate()
                local why = type(r) == "table" and r.Error or nil
                if why == "NotAtDigsite" then
                    TeleportTo(zone.Position + Vector3.new(0, 2, 0), 0.5)
                elseif why and why ~= "Busy" and why ~= "TooSoon" and why ~= "Revealing" and why ~= "StaleRound" then
                    if why ~= lastWhy then warn("[Dig] " .. Dump(r)) lastWhy = why end
                    if why == "Cooldown" or why == "MenuOpen" or why == "Typing" then idle += 1 end
                    if idle > 20 then break end
                    task.wait(0.5)
                elseif type(r) == "table" and r.Complete then
                    print("[Dig] " .. tostring(r.Reward) .. " x" .. tostring(r.Amount))
                    task.wait(1.7)
                    pcall(function() DigRewardPopup:Close() end)
                end
            end
            task.wait()
        end
    end)
end)

