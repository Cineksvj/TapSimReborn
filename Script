local FLAG_FIELDS = { "Equipped", "equipped", "Locked", "locked", "Lock", "Favorite", "favorite", "Favorited", "InUse", "inUse" }
local DEFAULT_TYPE_FIELDS = { "Type", "Id", "Name", "PetId", "Kind", "Species", "Template", "Variant", "Mutation", "Tier", "Rarity" }

local function IsUsableFor(pet, machine)
    if type(pet) ~= "table" then return true end
    for _, f in ipairs(FLAG_FIELDS) do
        if pet[f] == true then return false end
    end
    local m = string.lower(machine)
    for k, v in pairs(pet) do
        if type(k) == "string" and string.lower(k) == m and v == true then return false end
        if type(v) == "string" and string.lower(v) == m then return false end
    end
    return true
end

local function GroupKey(pet, machine)
    local learned = LearnedByMachine[machine]
    local parts = {}
    local fields = learned and learned.fields
    if fields and #fields > 0 then
        for _, f in ipairs(fields) do parts[#parts + 1] = f .. "=" .. tostring(pet[f]) end
    else
        for _, f in ipairs(DEFAULT_TYPE_FIELDS) do
            local v = pet[f]
            if type(v) == "string" and not IsUuid(v) then parts[#parts + 1] = f .. "=" .. v end
        end
    end
    return table.concat(parts, "|")
end

local function GetPetGroups(machine)
    local data, err = GetReplicaData()
    if not data then return nil, err end
    local store = PetStorePath and Resolve(data, PetStorePath)
    if not store then
        store, PetStorePath = FindStore(data, nil)
    end
    if not store then
        return nil, "no pet table found in the data (craft once by hand, then press 'Dump pet data')"
    end
    local groups, total = {}, 0
    for k, pet in pairs(store) do
        local uid = PetUid(k, pet)
        if uid then
            local key
            if type(pet) == "table" then
                if IsUsableFor(pet, machine) then key = GroupKey(pet, machine) end
            elseif type(pet) == "string" then
                key = pet
            end
            if key and key ~= "" then
                total += 1
                local g = groups[key]
                if not g then g = {} groups[key] = g end
                table.insert(g, uid)
            end
        end
    end
    return groups, total, store
end

local function PetExists(store, uid)
    for k, v in pairs(store) do
        if PetUid(k, v) == uid then return true end
    end
    return false
end

