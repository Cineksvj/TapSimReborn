-- ── world events: balloons, flying pigs, lucky blocks, meteors / mystery egg ──
local BalloonFlight = Req({ "Shared", "Admin", "BalloonFlight" })
local PigFlight = Req({ "Shared", "Admin", "PigFlight" })
local Balloons, Pigs = {}, {}
do
    local function track(store)
        return function(b) if type(b) == "table" and type(b.Uid) == "string" then store[b.Uid] = b end end
    end
    local function untrack(store)
        return function(uid) if type(uid) == "table" then uid = uid.Uid end if uid ~= nil then store[uid] = nil end end
    end
    pcall(function()
        RE("BalloonPartyService", "Launched").OnClientEvent:Connect(track(Balloons))
        RE("BalloonPartyService", "Popped").OnClientEvent:Connect(untrack(Balloons))
    end)
    pcall(function()
        RE("PigsCouldFlyService", "Launched").OnClientEvent:Connect(track(Pigs))
        RE("PigsCouldFlyService", "Caught").OnClientEvent:Connect(untrack(Pigs))
        RE("PigsCouldFlyService", "Retired").OnClientEvent:Connect(untrack(Pigs))
    end)
end

local function RefreshActive()
    local b = Invoke(RF("BalloonPartyService", "GetActive"))
    if type(b) == "table" then for _, e in ipairs(b) do if type(e) == "table" and e.Uid then Balloons[e.Uid] = e end end end
    local p = Invoke(RF("PigsCouldFlyService", "GetActive"))
    if type(p) == "table" then for _, e in ipairs(p) do if type(e) == "table" and e.Uid then Pigs[e.Uid] = e end end end
end

local function IsEventBreakable(t)
    return string.find(t, "Meteor", 1, true) ~= nil or t == "MysteryEgg"
end

local function EventWork(alive)
    local now = Now()
    local hrp = GetHrp()
    if not hrp then return false end
    local did = false
    -- balloons: RE.Hit:FireServer(uid) within HitRange 150
    local hitB = RE("BalloonPartyService", "Hit")
    for uid, b in pairs(Balloons) do
        if not alive() then return did end
        local t = now - (b.LaunchedAt or now)
        if BalloonFlight and t >= (BalloonFlight.Lifetime or 25) then
            Balloons[uid] = nil
        elseif hitB and BalloonFlight then
            local pos
            pcall(function() pos = BalloonFlight.Position(b, t) end)
            if pos then
                if (pos - hrp.Position).Magnitude > 120 then TeleportTo(pos - Vector3.new(0, 10, 0), 0.15) hrp = GetHrp() or hrp end
                hitB:FireServer(uid)
                did = true
                task.wait(0.11)
            end
        end
    end
    -- pigs: RE.Hit:FireServer(uid) within 120, max every 0.5 s per pig
    local hitP = RE("PigsCouldFlyService", "Hit")
    for uid, p in pairs(Pigs) do
        if not alive() then return did end
        local t = now - (p.LaunchedAt or now)
        if PigFlight and t >= (PigFlight.Lifetime or 60) then
            Pigs[uid] = nil
        elseif hitP and PigFlight and now - (p._last or 0) >= 0.5 then
            local pos
            pcall(function() pos = PigFlight.CFrame(p, t).Position end)
            if pos then
                if (pos - hrp.Position).Magnitude > 100 then TeleportTo(pos - Vector3.new(0, 8, 0), 0.15) hrp = GetHrp() or hrp end
                p._last = now
                hitP:FireServer(uid)
                did = true
            end
        end
    end
    -- lucky blocks: RE.CollectRequested:FireServer(model.Name) within Scale * 7 studs
    local collect = RE("LuckyBlockEventService", "CollectRequested")
    for _, m in ipairs(CollectionService:GetTagged("LuckyBlockEventServer")) do
        if not alive() then return did end
        if collect and m:IsA("Model") and m:GetAttribute("Opened") ~= true then
            local pos = m:GetPivot().Position
            TeleportTo(pos + Vector3.new(0, 2, 3), 0.3)
            for _ = 1, 8 do
                if m:GetAttribute("Opened") == true then break end
                collect:FireServer(m.Name)
                task.wait(0.3)
            end
            did = true
        end
    end
    -- meteors / mystery egg: breakables broken by taps
    local m = FindBreakable(IsEventBreakable)
    if m then BreakIt(m, alive) did = true end
    return did
end

local LastEventRefresh = 0
LoopToggle("Auto Events (balloons, pigs, lucky blocks, meteors)", 0.2, function(alive)
    if os.clock() - LastEventRefresh > 5 then LastEventRefresh = os.clock() RefreshActive() end
    local hasWork = next(Balloons) ~= nil or next(Pigs) ~= nil or #CollectionService:GetTagged("LuckyBlockEventServer") > 0
        or FindBreakable(IsEventBreakable) ~= nil
    if not hasWork then return end
    Trip("events", function()
        while alive() and EventWork(alive) do task.wait(0.05) end
    end)
end)

