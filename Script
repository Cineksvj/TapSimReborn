-- ═══════════ PET DATA ═══════════
-- Data.Pets.Owned[uid] = { Name, Tier, Locked, Frozen }, Data.Pets.Equipped = { uid }, Data.Pets.StorageLimit = max pets
local DataController
local function GetData()
    if not DataController then
        local ok, dc = pcall(function() return require(ReplicatedStorage.Controllers.Core.DataController) end)
        if not ok or type(dc) ~= "table" then return nil end
        DataController = dc
    end
    local ok, rep = pcall(function() return DataController:GetReplica() end)
    if ok and type(rep) == "table" and type(rep.Data) == "table" and type(rep.Data.Pets) == "table" then
        return rep.Data
    end
end

local function Storage()
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local n = 0
    for _ in pairs(data.Pets.Owned) do n += 1 end
    return n, tonumber(data.Pets.StorageLimit) or 150
end

-- ═══════════ AUTO OPEN VOID EGG (x8, no animation) ═══════════
local EGG, COUNT, MAX_INFLIGHT = "Void", 8, 2
local Seq, LastClientSeq, InOwnHatch = 0, 0, false
local EggWanted, EggPaused, EggConn = false, false, nil
local Pending, NextSendAt = {}, 0 -- hatch requests waiting for the server answer: [Seq] = sent at

local function FireHatch()
    if LastClientSeq > Seq then Seq = LastClientSeq end -- continue the game's own counter
    Seq += 1
    InOwnHatch = true
    EggEvent:FireServer({ Egg = EGG, Auto = false, Count = COUNT, Seq = Seq })
    InOwnHatch = false
    return Seq
end

-- The server paces hatches itself (it holds a request until the previous one is done and reports it in `Held`), so
-- spamming only fills its queue and gets "RateLimited"/"Cancelled" answers. The game's own client keeps the next request
-- one step "ahead" of the current one. Same here: keep exactly MAX_INFLIGHT requests open, refill the moment one is answered.
if EggResultEvent then
    EggResultEvent.OnClientEvent:Connect(function(r)
        if type(r) ~= "table" then return end
        if r.Seq ~= nil then Pending[r.Seq] = nil else Pending[next(Pending) or 0] = nil end
        if r.Success == true or r.Forced == true then return end
        local wait = (r.Error == "RateLimited" and 0.4) or (r.Error == "Cancelled" and 0.1) or (r.Error == "StorageFull" and 1) or 2
        NextSendAt = os.clock() + wait
        if r.Error ~= "RateLimited" and r.Error ~= "Cancelled" and r.Error ~= "StorageFull" then
            warn("[Egg] " .. tostring(r.Error))
        end
    end)
end

-- learn the game's hatch counter so the server does not drop our requests as old ones
pcall(function()
    if not (EggEvent and hookmetamethod and getnamecallmethod) then return end
    local wrap = newcclosure or function(f) return f end
    local old
    old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if self == EggEvent and getnamecallmethod() == "FireServer" and not InOwnHatch then
            local args = ...
            if type(args) == "table" and type(args.Seq) == "number" and args.Seq > LastClientSeq then
                LastClientSeq = args.Seq
            end
        end
        return old(self, ...)
    end))
end)

-- hatch animation: destroy the hatch screens while the egg toggle is on
local function IsHatchGui(obj)
    if not obj:IsA("ScreenGui") then return false end
    local n = string.lower(obj.Name)
    return string.find(n, "hatch") or string.find(n, "reveal") or string.find(n, "opening")
end
pcall(function()
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    pg.ChildAdded:Connect(function(child)
        if EggWanted and IsHatchGui(child) then pcall(function() child:Destroy() end) end
    end)
end)

Main:CreateToggle({
    Name = "Auto Open Void Egg",
    CurrentValue = false,
    Callback = function(Value)
        EggWanted = Value
        if EggConn then EggConn:Disconnect() EggConn = nil end
        if not Value then return end
        if not EggEvent then warn("[Egg] remote not found") return end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do
                if IsHatchGui(g) then pcall(function() g:Destroy() end) end
            end
        end
        Pending, NextSendAt = {}, 0
        EggConn = RunService.Heartbeat:Connect(function()
            if not EggWanted or EggPaused then return end
            local now = os.clock()
            if now < NextSendAt then return end
            local open = 0
            for seq, sentAt in pairs(Pending) do
                if now - sentAt > 12 then Pending[seq] = nil else open += 1 end
            end
            while open < MAX_INFLIGHT do
                Pending[FireHatch()] = now
                open += 1
            end
        end)
    end,
})

-- ═══════════ AUTO CRAFT: Golden -> Diamond -> Rainbow ═══════════
-- Storage nearly full (fewer free slots than one x8 hatch needs) -> pause the egg, then in this order, each step only
-- while the storage is STILL full after the previous one:
--   1. Golden machine: every set of 6 same Normal pets            (MachineCraftRequested Craft, Machine="Golden")
--   2. Diamond machine: every set of 5 same Golden pets           (Machine="Diamond")
--   3. Rainbow machine: claim finished pods, start pods with 5 same Diamond pets (Machine="Shiny", Start/Claim; 30 s each)
-- then teleport back to where you were and resume the egg. The crafting menus/cutscenes are kept closed meanwhile.
local MenuController
pcall(function() MenuController = require(ReplicatedStorage.Controllers.UI.MenuController) end)

local STAGES = {
    { machine = "Golden",  point = "Golden",  tier = "Normal", need = 6 },
    { machine = "Diamond", point = "Diamond", tier = "Golden", need = 5 },
}
local RAINBOW = { machine = "Shiny", point = "Rainbow", tier = "Diamond", need = 5, maxQueue = 3 }

-- pets of one tier grouped by name, skipping locked / frozen / equipped ones
local function GetGroups(tier)
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local equipped = {}
    for _, id in ipairs(data.Pets.Equipped or {}) do equipped[id] = true end
    local groups = {}
    for id, pet in pairs(data.Pets.Owned) do
        if type(pet) == "table" and pet.Tier == tier and pet.Locked ~= true and pet.Frozen == nil
            and not equipped[id] and type(pet.Name) == "string" then
            local g = groups[pet.Name]
            if not g then g = {} groups[pet.Name] = g end
            table.insert(g, id)
        end
    end
    return groups
end

-- the biggest complete set for a stage, or nil
local function PickSet(stage)
    local groups = GetGroups(stage.tier)
    if not groups then return nil end
    local best
    for _, ids in pairs(groups) do
        if #ids >= stage.need and (not best or #ids > #best) then best = ids end
    end
    if not best then return nil end
    local use = {}
    for i = 1, stage.need do use[i] = best[i] end
    return use
end

local function Full()
    local n, limit = Storage()
    return n ~= nil and limit - n < COUNT
end

-- the circle you stand on to open a machine: a part tagged "InteractionPoint" named Golden / Diamond / Rainbow.
-- We stand at its middle ON THE FLOOR (ray down from the middle), not at the middle of its box.
local function MachineTarget(pointName)
    local hrp = GetHrp()
    local best, bestDist
    for _, p in ipairs(CollectionService:GetTagged("InteractionPoint")) do
        if p.Name == pointName then
            local cf, size
            if p:IsA("BasePart") then cf, size = p.CFrame, p.Size
            elseif p:IsA("Model") then cf, size = p:GetBoundingBox() end
            if cf then
                local d = hrp and (hrp.Position - cf.Position).Magnitude or 0
                if not bestDist or d < bestDist then best, bestDist = { cf = cf, size = size }, d end
            end
        end
    end
    if not best then return nil end
    local pos = best.cf.Position
    local y = pos.Y - best.size.Y / 2 + 3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local hit = workspace:Raycast(pos, Vector3.new(0, -(best.size.Y / 2 + 12), 0), params)
    if hit then y = hit.Position.Y + 3 end
    return Vector3.new(pos.X, y, pos.Z)
end

local function TeleportTo(pos, settle)
    local hrp = GetHrp()
    if not hrp then return false end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos)
    task.wait(settle or 0.5)
    return true
end

local function GoTo(pointName)
    local target = MachineTarget(pointName)
    local hrp = GetHrp()
    if not (target and hrp) then return false end
    if (hrp.Position - target).Magnitude > 2.5 then TeleportTo(target, 0.6) end
    return true
end

-- ── keep the crafting GUI closed while we craft (menus + the 3D stage are client-only) ──
local CRAFT_MENUS = { "Golden", "Diamond", "CraftingRoll", "RainbowFuse", "RainbowMachine", "RainbowCraft", "GoldenBulk", "DiamondOld" }
local CraftMenuSet = {}
for _, n in ipairs(CRAFT_MENUS) do CraftMenuSet[n] = true end
local Hiding, HideConn, Hidden = false, nil, {}

local function HideCraftGuis()
    if MenuController then
        for _, n in ipairs(CRAFT_MENUS) do pcall(MenuController.Close, MenuController, n) end
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and CraftMenuSet[g.Name] and g.Enabled then
            g.Enabled = false
            Hidden[g] = true
        end
    end
end

local function StartHiding()
    if Hiding then return end
    Hiding = true
    HideCraftGuis()
    HideConn = RunService.Heartbeat:Connect(HideCraftGuis)
end

local function StopHiding()
    Hiding = false
    if HideConn then HideConn:Disconnect() HideConn = nil end
    for g in pairs(Hidden) do pcall(function() if g.Parent then g.Enabled = true end end) end
    Hidden = {}
end

-- ── server answers ──
local ResultSeq, LastResult = 0, nil
if MachineResultEvent then
    MachineResultEvent.OnClientEvent:Connect(function(r)
        if type(r) == "table" then
            ResultSeq += 1
            LastResult = r
        end
    end)
end

-- fires one machine request and waits for the answer. `done()` returns true when the data shows it went through.
local function Request(args, done)
    local seq0 = ResultSeq
    local ok, err = pcall(function() MachineEvent:FireServer(args) end)
    if not ok then return false, tostring(err) end
    local t0 = os.clock()
    while os.clock() - t0 < 6 and ResultSeq == seq0 do
        if done and done() then return true end
        task.wait(0.05)
    end
    if ResultSeq > seq0 then
        if LastResult.Success == true then return true end
        return false, tostring(LastResult.Error or LastResult.Message or LastResult.Reason or "refused")
    end
    if done and done() then return true end
    return false, "no answer from the server"
end

local function PetsGone(ids)
    return function()
        local data = GetData()
        return data ~= nil and data.Pets.Owned[ids[1]] == nil
    end
end

-- crafts every complete set of one stage; returns how many went through
local function CraftStage(stage)
    if not PickSet(stage) then return 0 end
    if not GoTo(stage.point) then warn("[Craft] " .. stage.machine .. " machine circle not found") return 0 end
    local crafted, fails = 0, 0
    while true do
        local use = PickSet(stage)
        if not use then break end
        local ok, why = Request({ PetIds = use, Machine = stage.machine, Action = "Craft" }, PetsGone(use))
        if ok then
            crafted += 1
            fails = 0
            task.wait(0.35)
        else
            fails += 1
            warn("[Craft] " .. stage.machine .. ": " .. tostring(why))
            if fails >= 4 then break end
            task.wait(math.min(0.5 * 2 ^ (fails - 1), 4))
            GoTo(stage.point)
        end
    end
    return crafted
end

-- rainbow pods: Data.Machines.Shiny.Queue[craftId] = { Name, PetCount, EndTime }
local function RainbowQueue()
    local data = GetData()
    local m = data and data.Machines and data.Machines.Shiny
    return (m and type(m.Queue) == "table") and m.Queue or nil
end

local function RainbowReadyIds()
    local q = RainbowQueue()
    local ready, total, now = {}, 0, workspace:GetServerTimeNow()
    for id, entry in pairs(q or {}) do
        total += 1
        if type(entry) == "table" and type(entry.EndTime) == "number" and entry.EndTime <= now then table.insert(ready, id) end
    end
    return ready, total
end

-- claims finished pods and starts new ones with 5 same Diamond pets (30 s each); returns pets removed from storage
local function CraftRainbow()
    local ready, total = RainbowReadyIds()
    local canStart = total - #ready < RAINBOW.maxQueue and PickSet(RAINBOW) ~= nil
    if #ready == 0 and not canStart then return 0 end
    if not GoTo(RAINBOW.point) then warn("[Craft] Rainbow machine circle not found") return 0 end
    for _, id in ipairs(ready) do
        local ok, why = Request({ Machine = "Shiny", Action = "Claim", CraftId = id }, function()
            local q = RainbowQueue()
            return q ~= nil and q[id] == nil
        end)
        if not ok then warn("[Craft] Rainbow claim: " .. tostring(why)) end
        task.wait(0.35)
    end
    local removed, fails = 0, 0
    while true do
        local _, queued = RainbowReadyIds()
        if queued >= RAINBOW.maxQueue then break end
        local use = PickSet(RAINBOW)
        if not use then break end
        local ok, why = Request({ PetIds = use, Machine = "Shiny", Action = "Start" }, PetsGone(use))
        if ok then
            removed += #use
            fails = 0
            task.wait(0.35)
        else
            fails += 1
            warn("[Craft] Rainbow start: " .. tostring(why))
            if fails >= 3 then break end
            task.wait(1)
        end
    end
    return removed
end

local CraftToken = 0
Main:CreateToggle({
    Name = "Auto Craft (Golden > Diamond > Rainbow)",
    CurrentValue = false,
    Callback = function(Value)
        CraftToken += 1
        local my = CraftToken
        if not Value then
            EggPaused = false
            StopHiding()
            return
        end
        if not MachineEvent then warn("[Craft] remote not found") return end
        task.spawn(function()
            while my == CraftToken do
                if Full() then
                    EggPaused = true
                    task.wait(1.2) -- let hatches in flight land
                    local hrp = GetHrp()
                    local home = hrp and hrp.Position
                    StartHiding()
                    local did = 0
                    for _, stage in ipairs(STAGES) do
                        if my ~= CraftToken then break end
                        if Full() then did += CraftStage(stage) end
                    end
                    if my == CraftToken and Full() then did += CraftRainbow() end
                    if home and my == CraftToken then TeleportTo(home + Vector3.new(0, 1, 0), 0.4) end
                    StopHiding()
                    if did == 0 or Full() then
                        task.wait(2) -- nothing to craft yet (rainbow pods still running?): stay paused, re-check
                    else
                        EggPaused = false
                    end
                else
                    EggPaused = false
                    task.wait(0.15)
                end
            end
            EggPaused = false
            StopHiding()
        end)
    end,
})
