local VOLATILE = {
    equipped = true, locked = true, favorite = true, favorited = true, lock = true, inuse = true,
    slot = true, order = true, index = true, level = true, exp = true, xp = true, age = true, new = true, seen = true,
}

-- called from the hook right BEFORE the server consumes the pets: snapshot them and learn the grouping fields
local function LearnSchema(machine, ids)
    local want = {}
    for _, id in ipairs(ids) do want[id] = true end
    LearnedByMachine[machine] = { need = #ids }
    local data = GetReplicaData()
    if not data then return end
    local store, path = FindStore(data, want)
    if not store then return end
    PetStorePath = path
    local entries = {}
    for k, v in pairs(store) do
        local u = PetUid(k, v)
        if u and want[u] and type(v) == "table" then table.insert(entries, v) end
    end
    local fields = {}
    if #entries >= 2 then
        for f, v in pairs(entries[1]) do
            if (type(v) == "string" or type(v) == "boolean") and not VOLATILE[string.lower(tostring(f))] and not IsUuid(v) then
                local same = true
                for i = 2, #entries do
                    if entries[i][f] ~= v then same = false break end
                end
                if same then table.insert(fields, f) end
            end
        end
        table.sort(fields)
    end
    LearnedByMachine[machine].fields = fields
    LearnedByMachine[machine].path = path
    SetLabel(string.format("Learned %s: %d pets, group by [%s], store %s", machine, #ids, table.concat(fields, ","), table.concat(path or {}, ".")))
end

local function RecordCraft(args)
    if InOwnCall or type(args) ~= "table" then return end
    if args.Action ~= "Craft" or type(args.PetIds) ~= "table" or type(args.Machine) ~= "string" then return end
    local ids = {}
    for _, id in ipairs(args.PetIds) do
        if IsUuid(id) then table.insert(ids, id) end
    end
    if #ids >= 2 then
        local hrp = GetHrp()
        if hrp then MachineSpots[args.Machine] = hrp.CFrame end -- you are near the machine right now: remember the spot
        pcall(LearnSchema, args.Machine, ids)
        task.defer(function()
            pcall(function()
                Rayfield:Notify({ Title = "Craft learned", Content = args.Machine .. " x" .. #ids, Duration = 4 })
            end)
        end)
    end
end

