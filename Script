local HideCraftGui = true
local CraftGuiWords = { "machine", "golden", "craft", "diamond" }
local HiddenGuis = {}
local CraftGuiUntil = 0

local function IsCraftGui(obj)
    if not obj:IsA("ScreenGui") then return false end
    local n = string.lower(obj.Name)
    for _, w in ipairs(CraftGuiWords) do
        if string.find(n, w, 1, true) then return true end
    end
