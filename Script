-- ─────────────────────────── helpers ───────────────────────────
local H = {}
function H.New(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
function H.Corner(p, r) return H.New("UICorner", { CornerRadius = UDim.new(0, r or 10) }, p) end
function H.Stroke(p, t, c) return H.New("UIStroke", { Color = c or T.White, Transparency = t or 0.92, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p) end
function H.Pad(p, t, r, b, l) return H.New("UIPadding", { PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r or t), PaddingBottom = UDim.new(0, b or t), PaddingLeft = UDim.new(0, l or r or t) }, p) end
function H.VList(p, gap) return H.New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 0) }, p) end
function H.HList(p, gap, align) return H.New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 0), VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = align or Enum.HorizontalAlignment.Left }, p) end
function H.Frame(props, parent) props.BorderSizePixel = 0 return H.New("Frame", props, parent) end
function H.Text(props, parent)
    props.BackgroundTransparency = 1 props.BorderSizePixel = 0
    props.Font = props.Font or FONT props.TextColor3 = props.TextColor3 or T.Label props.TextSize = props.TextSize or 14
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return H.New("TextLabel", props, parent)
end
function H.Button(props, parent)
    props.AutoButtonColor = false props.BorderSizePixel = 0 props.Text = props.Text or ""
    props.Font = props.Font or FONT
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
    return H.New("TextButton", props, parent)
end
function H.Tween(o, t, goal, style)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
    tw:Play()
    return tw
end
function H.Icon(name, size, color, props, parent)
    props = props or {}
    local def = ICONS[name] or ICONS.info
    props.BackgroundTransparency = 1 props.BorderSizePixel = 0
    props.Size = props.Size or UDim2.fromOffset(size, size)
    props.Image = "rbxassetid://" .. def[1]
    props.ImageRectOffset = Vector2.new(def[2], def[3]) props.ImageRectSize = Vector2.new(48, 48)
    props.ImageColor3 = color or T.Sub props.ScaleType = Enum.ScaleType.Fit
    return H.New(props.Button and "ImageButton" or "ImageLabel", (function() props.Button = nil return props end)(), parent)
end
function H.Hover(b, rest, hover, prop)
    prop = prop or "BackgroundColor3"
    b.MouseEnter:Connect(function() H.Tween(b, 0.14, { [prop] = hover }) end)
    b.MouseLeave:Connect(function() H.Tween(b, 0.2, { [prop] = rest }) end)
end
function H.Glass(f, factor) f.BackgroundTransparency = math.clamp(T.Glass * (factor or 1), 0, 0.75) return f end
function H.OnAccent(fn) UI.AccentHooks[#UI.AccentHooks + 1] = fn fn(T.Accent) end
function H.Time(s) s = math.floor(s) return string.format("%d:%02d", s // 60, s % 60) end
function H.Ping()
    local ok, v = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and math.floor(v + 0.5) or 0
end

