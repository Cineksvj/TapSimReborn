-- drag by the header or the brand area
do
    local dragging, startMouse, startPos = false, nil, nil
    local function begin(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local m = UIS:GetMouseLocation()
        local sp, ss = Search.AbsolutePosition, Search.AbsoluteSize
        local tp, ts = Tools.AbsolutePosition, Tools.AbsoluteSize
        if m.X >= sp.X and m.X <= sp.X + ss.X and m.Y >= sp.Y and m.Y <= sp.Y + ss.Y then return end
        if m.X >= tp.X and m.X <= tp.X + ts.X and m.Y >= tp.Y and m.Y <= tp.Y + ts.Y then return end
        dragging, startMouse, startPos = true, m, Win.Position
    end
    Header.InputBegan:Connect(begin)
    Brand.InputBegan:Connect(begin)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = UIS:GetMouseLocation() - startMouse
            Win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            Config.Data.Win = { Win.AbsolutePosition.X, Win.AbsolutePosition.Y } Config.Save()
        end
    end)
end

-- keyboard: Right Shift menu, Ctrl+F search, toggle keybinds, bind capture
UIS.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode.Name
