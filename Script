-- rings: Bronze < Silver < Gold < Platinum < Diamond; same ring -> the one with the better boosts
local RING_TIER = { BronzeRing = 1, SilverRing = 2, GoldRing = 3, PlatinumRing = 4, DiamondRing = 5 }
local BOOST_WEIGHT = { ClickMultiplier = 1, HatchSpeed = 1.2, CriticalChance = 2, RebirthMultiplier = 2, SecretLuck = 4, Walkspeed = 0.1 }
local function RingScore(r)
    if type(r) ~= "table" then return -1 end
    local tier = RING_TIER[tostring(r.Name)] or RING_TIER[(tostring(r.Name):gsub("%s", ""))] or 0
    local s = tier * 100
    for _, b in ipairs(type(r.Boosts) == "table" and r.Boosts or {}) do
        if type(b) == "table" then s += (BOOST_WEIGHT[b.Type] or 1) * (tonumber(b.Value) or 0) * 100 end
    end
    return s
end
local function RingLabel(r) return type(r) == "table" and tostring(r.Name) or "none" end
-- claims a pending relic reward: replace when the new ring scores higher, keep otherwise; returns true when one was handled
local function ClaimRelic()
    local data = GetData()
    local col = data and data.Colosseum or {}
    local pending = col.PendingReward
    if type(pending) ~= "table" then return false end
    local new, old = pending.NewRelic, col.Relic
    local replace = old == nil or RingScore(new) > RingScore(old)
    local r = Invoke(RF("ColosseumService", "ClaimMinigameReward"), replace and "replace" or "keep")
    print(string.format("[PetDefense] relic %s: new %s (%d) vs current %s (%d) -> %s", replace and "REPLACED" or "kept", RingLabel(new), math.floor(RingScore(new)), RingLabel(old), math.floor(RingScore(old)), Dump(r)))
    Status(string.format("PetDefense: %s %s (%s)", replace and "equipped" or "kept old ring, rejected", RingLabel(new), replace and "better" or "not better"))
    return true
end

LoopToggle("Auto Pet Defense (bone pit)", 30, function(alive)
    local data = GetData()
    if not data then return end
    local col = data.Colosseum or {}
    if col.PendingReward ~= nil then ClaimRelic() task.wait(1) end
    local left = (col.Cooldown or 0) + 7200 - os.time()
