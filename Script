-- ═══════════ PET DATA ═══════════
-- Data.Pets.Owned[uid] = { Name, Tier, Locked, Frozen }, Data.Pets.Equipped = { uid }, Data.Pets.StorageLimit = max pets
local DataController
local function GetData()
    if not DataController then
        local ok, dc = pcall(function() return require(ReplicatedStorage.Controllers.Core.DataController) end)
        if not ok or type(dc) ~= "table" then return nil end
        DataController = dc
    end
    local ok, rep = pcall(function() return DataController:GetReplica() end)
    if ok and type(rep) == "table" and type(rep.Data) == "table" and type(rep.Data.Pets) == "table" then
        return rep.Data
    end
end

local function Storage()
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local n = 0
    for _ in pairs(data.Pets.Owned) do n += 1 end
    return n, tonumber(data.Pets.StorageLimit) or 150
end

-- ═══════════ AUTO OPEN VOID EGG (x8, no animation) ═══════════
local EGG, COUNT, BURST = "Void", 8, 5
local Seq, LastClientSeq, InOwnHatch = 0, 0, false
local EggWanted, EggPaused, EggConn = false, false, nil

local function FireHatch()
    if LastClientSeq > Seq then Seq = LastClientSeq end -- continue the game's own counter
    Seq += 1
    InOwnHatch = true
    EggEvent:FireServer({ Egg = EGG, Auto = false, Count = COUNT, Seq = Seq })
    InOwnHatch = false
end

-- learn the game's hatch counter so the server does not drop our requests as old ones
pcall(function()
    if not (EggEvent and hookmetamethod and getnamecallmethod) then return end
    local wrap = newcclosure or function(f) return f end
    local old
    old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if self == EggEvent and getnamecallmethod() == "FireServer" and not InOwnHatch then
            local args = ...
            if type(args) == "table" and type(args.Seq) == "number" and args.Seq > LastClientSeq then
                LastClientSeq = args.Seq
            end
        end
        return old(self, ...)
    end))
end)

-- hatch animation: destroy the hatch screens while the egg toggle is on
local function IsHatchGui(obj)
    if not obj:IsA("ScreenGui") then return false end
    local n = string.lower(obj.Name)
    return string.find(n, "hatch") or string.find(n, "reveal") or string.find(n, "opening")
end
pcall(function()
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    pg.ChildAdded:Connect(function(child)
        if EggWanted and IsHatchGui(child) then pcall(function() child:Destroy() end) end
    end)
end)

Main:CreateToggle({
    Name = "Auto Open Void Egg",
    CurrentValue = false,
    Callback = function(Value)
        EggWanted = Value
        if EggConn then EggConn:Disconnect() EggConn = nil end
        if not Value then return end
        if not EggEvent then warn("[Egg] remote not found") return end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do
                if IsHatchGui(g) then pcall(function() g:Destroy() end) end
            end
        end
        EggConn = RunService.Heartbeat:Connect(function()
            if EggWanted and not EggPaused then
                for _ = 1, BURST do FireHatch() end
            end
        end)
    end,
})

-- ═══════════ AUTO GOLD ═══════════
-- Storage nearly full (fewer free slots than one x8 hatch needs) -> pause the egg, go to the Golden machine circle,
-- craft EVERY set of 6 same pets, go back to where you were, resume the egg. Repeats forever.
local SOURCE_TIER, NEED = "Normal", 6

local function GetGroups()
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local equipped = {}
    for _, id in ipairs(data.Pets.Equipped or {}) do equipped[id] = true end
    local groups = {}
    for id, pet in pairs(data.Pets.Owned) do
        if type(pet) == "table" and pet.Tier == SOURCE_TIER and pet.Locked ~= true and pet.Frozen == nil
            and not equipped[id] and type(pet.Name) == "string" then
            local g = groups[pet.Name]
            if not g then g = {} groups[pet.Name] = g end
            table.insert(g, id)
        end
    end
    return groups
end

local function CountSets()
    local groups = GetGroups()
    local sets = 0
    for _, ids in pairs(groups or {}) do sets += math.floor(#ids / NEED) end
    return sets
end

-- the circle you stand on to open the machine: a part tagged "InteractionPoint" named "Golden".
-- We stand at the middle of it ON THE FLOOR (ray down from the middle), not at the middle of its box.
local function MachineTarget()
    local hrp = GetHrp()
    local best, bestDist
    for _, p in ipairs(CollectionService:GetTagged("InteractionPoint")) do
        if p.Name == "Golden" then
            local cf, size
            if p:IsA("BasePart") then cf, size = p.CFrame, p.Size
            elseif p:IsA("Model") then cf, size = p:GetBoundingBox() end
            if cf then
                local d = hrp and (hrp.Position - cf.Position).Magnitude or 0
                if not bestDist or d < bestDist then best, bestDist = { cf = cf, size = size }, d end
            end
        end
    end
    if not best then return nil end
    local pos = best.cf.Position
    local y = pos.Y - best.size.Y / 2 + 3 -- fallback: bottom of the zone
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local hit = workspace:Raycast(pos, Vector3.new(0, -(best.size.Y / 2 + 12), 0), params)
    if hit then y = hit.Position.Y + 3 end
    return Vector3.new(pos.X, y, pos.Z)
end

local function TeleportTo(pos, settle)
    local hrp = GetHrp()
    if not hrp then return false end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos)
    task.wait(settle or 0.5)
    return true
end

local function GoToMachine()
    local target = MachineTarget()
    if not target then return false end
    local hrp = GetHrp()
    if not hrp then return false end
    if (hrp.Position - target).Magnitude > 2.5 then TeleportTo(target, 0.6) end
    return true
end

-- hide the crafting GUI/cutscene while we craft (client-only visuals)
local HideUntil, Hidden = 0, {}
local function IsCraftGui(g)
    if not g:IsA("ScreenGui") then return false end
    local n = string.lower(g.Name)
    return string.find(n, "machine", 1, true) or string.find(n, "golden", 1, true) or string.find(n, "craft", 1, true)
end
local function HideCraftGuis()
    HideUntil = os.clock() + 20
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, g in ipairs(pg:GetChildren()) do
        if IsCraftGui(g) and g.Enabled then g.Enabled = false Hidden[g] = true end
    end
end
local function RestoreGuis()
    HideUntil = 0
    for g in pairs(Hidden) do pcall(function() if g.Parent then g.Enabled = true end end) end
    Hidden = {}
end
pcall(function()
    LocalPlayer:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
        if os.clock() < HideUntil and IsCraftGui(child) then
            task.defer(function() pcall(function() child.Enabled = false Hidden[child] = true end) end)
        end
    end)
end)

local ResultSeq, LastResult = 0, nil
if MachineResultEvent then
    MachineResultEvent.OnClientEvent:Connect(function(r)
        if type(r) == "table" and r.Action ~= "Start" and r.Action ~= "Claim" then
            ResultSeq += 1
            LastResult = r
        end
    end)
end

-- one craft: "ok" | "none" (no complete set) | "fail", reason
local function CraftOnce()
    local groups = GetGroups()
    if not groups then return "fail", "pet data not ready" end
    local best
    for _, ids in pairs(groups) do
        if #ids >= NEED and (not best or #ids > #best) then best = ids end
    end
    if not best then return "none" end
    local use = {}
    for i = 1, NEED do use[i] = best[i] end
    HideCraftGuis()
    local seq0 = ResultSeq
    local ok, err = pcall(function()
        MachineEvent:FireServer({ PetIds = use, Machine = "Golden", Action = "Craft" })
    end)
    if not ok then return "fail", tostring(err) end
    local t0 = os.clock()
    while os.clock() - t0 < 6 and ResultSeq == seq0 do
        local data = GetData()
        if data and data.Pets.Owned[use[1]] == nil then return "ok" end -- consumed, result may lag
        task.wait(0.05)
    end
    if ResultSeq > seq0 then
        if LastResult.Success == true then return "ok" end
        return "fail", tostring(LastResult.Error or LastResult.Message or LastResult.Reason or "refused")
    end
    return "fail", "no answer from the server"
end

local function CraftAll()
    if not GoToMachine() then warn("[Gold] machine circle not found") return 0 end
    local crafted, fails = 0, 0
    while true do
        local status, why = CraftOnce()
        if status == "ok" then
            crafted += 1
            fails = 0
            task.wait(0.35)
        elseif status == "none" then
            break
        else
            fails += 1
            warn("[Gold] " .. tostring(why))
            if fails >= 4 then break end
            task.wait(math.min(0.5 * 2 ^ (fails - 1), 4))
            GoToMachine() -- maybe pushed off the circle
        end
    end
    return crafted
end

local GoldToken = 0
Main:CreateToggle({
    Name = "Auto Gold",
    CurrentValue = false,
    Callback = function(Value)
        GoldToken += 1
        local my = GoldToken
        if not Value then
            EggPaused = false
            RestoreGuis()
            return
        end
        if not MachineEvent then warn("[Gold] remote not found") return end
        task.spawn(function()
            while my == GoldToken do
                local n, limit = Storage()
                if n and limit - n < COUNT then
                    EggPaused = true
                    task.wait(1.2) -- let hatches in flight land
                    local hrp = GetHrp()
                    local home = hrp and hrp.Position
                    local crafted = CraftAll()
                    if home and my == GoldToken then TeleportTo(home + Vector3.new(0, 1, 0), 0.4) end
                    RestoreGuis()
                    local n2, limit2 = Storage()
                    if crafted == 0 or (n2 and limit2 - n2 < COUNT) then
                        task.wait(2) -- nothing to craft / still full: stay paused, re-check
                    else
                        EggPaused = false
                    end
                else
                    EggPaused = false
                    task.wait(0.15)
                end
            end
            EggPaused = false
        end)
    end,
})
