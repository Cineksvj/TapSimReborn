-- pets grouped by Name that this machine may use (right tier, not locked/frozen/equipped)
local function GetGroups(machine)
    local cfg = MachineCfg(machine)
    local data = GetData()
    if not (cfg and data and type(data.Pets.Owned) == "table") then return nil end
    local equipped = {}
    for _, id in ipairs(data.Pets.Equipped or {}) do equipped[id] = true end
    local groups = {}
    for id, pet in pairs(data.Pets.Owned) do
        if type(pet) == "table" and pet.Tier == cfg.SourceTier and pet.Locked ~= true and pet.Frozen == nil
            and not equipped[id] and type(pet.Name) == "string" then
            local g = groups[pet.Name]
            if not g then g = {} groups[pet.Name] = g end
            table.insert(g, id)
        end
    end
    return groups, #cfg.Chances
end

local function CountSets(machine)
    local groups, need = GetGroups(machine)
    if not groups then return 0 end
    local sets = 0
    for _, ids in pairs(groups) do sets += math.floor(#ids / need) end
    return sets
end

-- ── teleporting (machine point + the egg spot) ──
local MachineSpots = {} -- manual fallback: [machine] = CFrame saved with the button
local PointNames = { Golden = "Golden", Diamond = "Diamond" }

local function MachineTarget(machine)
    local want = PointNames[machine] or machine
    local best, bestDist
    local hrp = GetHrp()
    for _, p in ipairs(CollectionService:GetTagged("InteractionPoint")) do
        if p.Name == want and (p:IsA("BasePart") or p:IsA("Model")) then
            local cf = p:IsA("BasePart") and p.CFrame or p:GetBoundingBox()
            local d = hrp and (hrp.Position - cf.Position).Magnitude or 0
            if not best or d < bestDist then best, bestDist = cf, d end
        end
    end
    if best then return best + Vector3.new(0, 1, 0) end
    return MachineSpots[machine]
end

local function TeleportTo(cf, settle)
    local hrp = GetHrp()
    if not hrp then return false end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = cf
    task.wait(settle or 0.5) -- let the server see the new position
    return true
end

local function GoNearMachine(machine)
    local target = MachineTarget(machine)
    if not target then
        return false, "machine point not found: stand on the " .. machine .. " machine and press 'Save machine spot'"
    end
    local hrp = GetHrp()
    if not hrp then return false, "no character" end
    if (hrp.Position - target.Position).Magnitude > 3 then
        TeleportTo(target, 0.6)
    end
    return true
end

