-- ═══════════ PET DATA ═══════════
-- Data.Pets.Owned[uid] = { Name, Tier, Locked, Frozen }, Data.Pets.Equipped = { uid }, Data.Pets.StorageLimit = max pets
local DataController
local function GetData()
    if not DataController then
        local ok, dc = pcall(function() return require(ReplicatedStorage.Controllers.Core.DataController) end)
        if not ok or type(dc) ~= "table" then return nil end
        DataController = dc
    end
    local ok, rep = pcall(function() return DataController:GetReplica() end)
    if ok and type(rep) == "table" and type(rep.Data) == "table" and type(rep.Data.Pets) == "table" then
        return rep.Data
    end
end

local function Storage()
    local data = GetData()
    if not (data and type(data.Pets.Owned) == "table") then return nil end
    local n = 0
    for _ in pairs(data.Pets.Owned) do n += 1 end
    return n, tonumber(data.Pets.StorageLimit) or 150
end

-- ═══════════ AUTO OPEN VOID EGG (x8, no animation) ═══════════
local EGG, MAX_INFLIGHT = "Void", 2

-- hatch count: the biggest one you can use, the way the game's own auto-open picks it:
-- 8 needs the x8 gamepass (or an OctoHatch boost) and enough coins for 8 eggs, else 3, else 1.
local GamepassPerks, BoostFormula, EggPricing, LaunchEggConfig
pcall(function()
    GamepassPerks = require(ReplicatedStorage.Shared.Monetization.GamepassPerks)
    BoostFormula = require(ReplicatedStorage.Shared.Items.BoostFormula)
    EggPricing = require(ReplicatedStorage.Shared.Pets.EggPricing)
    LaunchEggConfig = require(ReplicatedStorage.Shared.Pets.LaunchEggConfig)
end)
local LastCount = 8
local function HatchCount()
    local data = GetData()
    if not data then return LastCount end
    local ok, n = pcall(function()
        local has8 = (GamepassPerks and GamepassPerks.Has(data, "x8Egg")) or (BoostFormula and BoostFormula.HasType(data, "OctoHatch"))
        local coins = (data.Currencies and data.Currencies.Coins) or 0
        local price = LaunchEggConfig and LaunchEggConfig[EGG] and LaunchEggConfig[EGG].Price
        local function afford(k)
            if not (EggPricing and price) then return true end
            return EggPricing.GetTotal(data, EGG, price, k) <= coins
        end
        if has8 and afford(8) then return 8 end
        if afford(3) then return 3 end
        return 1
    end)
    if ok and type(n) == "number" then LastCount = n end
    return LastCount
end
local Seq, LastClientSeq, InOwnHatch = 0, 0, false
local EggWanted, EggConn = false, nil
local EggHolds = 0 -- > 0 while a trip (crafting, digging, ...) keeps the egg paused
local function HoldEgg(on) EggHolds = math.max(0, EggHolds + (on and 1 or -1)) end
local Pending, NextSendAt = {}, 0 -- hatch requests waiting for the server answer: [Seq] = sent at
local PendingCount = {} -- [Seq] = eggs asked for, so the next request only uses the slots still free
-- free storage slots once every request in flight has landed
local function FreeSlots()
    local n, limit = Storage()
    if not n then return 0 end
    local inflight = 0
    for seq in pairs(Pending) do inflight += PendingCount[seq] or 0 end
    return limit - n - inflight
end
-- the count for the next request: the usual 8 / 3 / 1, capped by the free slots (0 = storage is full)
local function NextCount()
    local free = FreeSlots()
    if free < 1 then return 0 end
    return math.min(HatchCount(), free)
end
local EggTooFar = false -- set when the server answers "TooFar": the egg keeper below walks you back to the egg

local function FireHatch(count)
    if LastClientSeq > Seq then Seq = LastClientSeq end -- continue the game's own counter
    Seq += 1
    InOwnHatch = true
    EggEvent:FireServer({ Egg = EGG, Auto = false, Count = count or HatchCount(), Seq = Seq })
    InOwnHatch = false
    PendingCount[Seq] = count or HatchCount()
    return Seq
end

-- The server paces hatches itself (it holds a request until the previous one is done and reports it in `Held`), so
-- spamming only fills its queue and gets "RateLimited"/"Cancelled" answers. The game's own client keeps the next request
-- one step "ahead" of the current one. Same here: keep exactly MAX_INFLIGHT requests open, refill the moment one is answered.
if EggResultEvent then
    EggResultEvent.OnClientEvent:Connect(function(r)
        if type(r) ~= "table" then return end
        if r.Seq ~= nil then Pending[r.Seq] = nil PendingCount[r.Seq] = nil else local k = next(Pending) or 0 Pending[k] = nil PendingCount[k] = nil end
        if r.Success == true or r.Forced == true then return end
        local wait = (r.Error == "RateLimited" and 0.4) or (r.Error == "Cancelled" and 0.1) or (r.Error == "StorageFull" and 1) or 2
        NextSendAt = os.clock() + wait
        if r.Error == "TooFar" then EggTooFar = true end
        if r.Error ~= "RateLimited" and r.Error ~= "Cancelled" and r.Error ~= "StorageFull" then
            warn("[Egg] " .. tostring(r.Error))
        end
    end)
end

-- ═══════════ ANTI-AFK ═══════════
-- 1. answers Roblox's 20-minute idle check (Player.Idled) with a virtual click
-- 2. sends a tiny virtual input every 90 s so no idle timer ever runs out
-- 3. blocks client-side Kick() calls (a LocalScript cannot kick you; the server still can)
-- 4. Auto rejoin: after a disconnect / kick message it teleports back into the same server, then into the game
local VirtualUser = game:GetService("VirtualUser")
local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")
local AntiAfk, AntiKick, AutoRejoin = false, false, false
